# Anfitorio API · production image (pnpm workspace + tsx runtime)
#
# Tanda 4 (instalabilidad): the previous image was installed with npm on a pnpm
# `workspace:*` monorepo (EUNSUPPORTEDPROTOCOL) and started a `dist/server.js`
# that the tsc emit never produced (packages/* are consumed from src via
# tsconfig paths). This image installs with the pinned pnpm (corepack, same
# version as the root `packageManager`), generates the Prisma client and runs
# the API through tsx, the official runtime (apps/api `start` script).
#
# Build context = the pnpm root (hotelos/):
#   docker build -f deploy/Dockerfile.api -t anfitorio-api .
#
# The schema is NOT applied here: deploy/scripts/deploy.sh runs
# `db:adopt-baseline --apply` + `db:migrate:deploy` (never `prisma db push`)
# before rolling the container. `prisma` (CLI) stays in the image because the
# compose role executes those steps inside this container.

# ---- stage 1: deps + prisma client ------------------------------------------
FROM node:22-bookworm-slim AS builder

# openssl: Prisma engines; ca-certificates: registry + Let's Encrypt chain.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /repo

# Manifests first so the install layer is cached while only source changes.
# Every workspace manifest must be present: pnpm validates the frozen
# lockfile against ALL importers listed in pnpm-lock.yaml.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/admin-web/package.json ./apps/admin-web/
COPY apps/ai-gateway/package.json ./apps/ai-gateway/
COPY apps/api/package.json ./apps/api/
COPY apps/guest-web/package.json ./apps/guest-web/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/worker/package.json ./apps/worker/
COPY packages/ai-tools/package.json ./packages/ai-tools/
COPY packages/compliance/package.json ./packages/compliance/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/onboarding/package.json ./packages/onboarding/
COPY packages/product/package.json ./packages/product/
COPY packages/revenue/package.json ./packages/revenue/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

# `--filter @hotelos/api...` = the API plus its workspace dependencies only
# (mobile/admin-web deps are never downloaded). No `--prod`: tsx is the
# official runtime (`node --import tsx`) but it is a devDependency of
# @hotelos/api, and `prisma` (CLI, devDependency of @hotelos/database) is
# needed for migrate deploy inside the container, so the full tree is
# installed on purpose (same lockfile as CI; nothing promoted to dependencies).
RUN pnpm install --frozen-lockfile --filter @hotelos/api...

# Source of the API and every package it imports through tsconfig paths.
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm --filter @hotelos/database db:generate

# ---- stage 2: runtime --------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates tini curl \
    && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

RUN groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder --chown=app:app /repo /app

USER app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
WORKDIR /app/apps/api
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --retries=6 CMD curl -fsS http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
# Same command as `pnpm --filter @hotelos/api start`.
CMD ["node", "--import", "tsx", "src/server.ts"]
