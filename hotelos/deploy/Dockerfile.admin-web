# Anfitorio admin-web · production image (Vite static build behind nginx)
#
# The API origin is BAKED into the bundle at build time through VITE_API_URL
# (apps/admin-web/src/services/api-client.ts falls back to http://localhost:3000
# when it is missing, which produces a green build that cannot talk to the
# API). The build therefore REFUSES an empty VITE_API_URL. Derive it from the
# public origin: VITE_API_URL=${APP_BASE_URL}/api (Caddy serves the API under
# /api on the same origin).
#
# Build context = the pnpm root (hotelos/):
#   docker build -f deploy/Dockerfile.admin-web \
#     --build-arg VITE_API_URL=https://demo.hotelos.es/api -t anfitorio-admin-web .

# ---- stage 1: builder --------------------------------------------------------
FROM node:22-bookworm-slim AS builder

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /repo

ARG VITE_API_URL
ARG VITE_SENTRY_DSN=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
RUN test -n "$VITE_API_URL" || { echo "VITE_API_URL build-arg is required (e.g. https://demo.hotelos.es/api)"; exit 1; }

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/admin-web/package.json ./apps/admin-web/
COPY apps/ai-gateway/package.json ./apps/ai-gateway/
COPY apps/api/package.json ./apps/api/
COPY apps/guest-web/package.json ./apps/guest-web/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/worker/package.json ./apps/worker/
COPY packages/ai-tools/package.json ./packages/ai-tools/
COPY packages/compliance/package.json ./packages/compliance/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/onboarding/package.json ./packages/onboarding/
COPY packages/product/package.json ./packages/product/
COPY packages/revenue/package.json ./packages/revenue/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

RUN pnpm install --frozen-lockfile --filter @hotelos/admin-web...

COPY packages ./packages
COPY apps/admin-web ./apps/admin-web

RUN pnpm --filter @hotelos/admin-web build
# Fail the build if the bundle was baked with the localhost fallback.
RUN ! grep -rl "http://localhost:3000" apps/admin-web/dist/assets >/dev/null \
    || { echo "admin-web bundle still points at http://localhost:3000"; exit 1; }

# ---- stage 2: nginx runtime --------------------------------------------------
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/apps/admin-web/dist /usr/share/nginx/html

# SPA fallback (also for /accept-invite and /reset-password deep links),
# immutable cache for hashed assets, no-store for index.html so a deploy is
# visible on the next page load.
RUN cat > /etc/nginx/conf.d/admin-web.conf <<'NGINX'
server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1024;

    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    location / {
        add_header Cache-Control "no-store, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
NGINX

EXPOSE 80
