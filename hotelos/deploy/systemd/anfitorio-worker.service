# Anfitorio worker · systemd unit (pg-boss queue jobs: webhooks.deliver)
#
# Same runtime and environment file as anfitorio-api.service. The worker
# NEVER runs the in-process schedulers: RUN_SCHEDULERS=false is forced on the
# command line through /usr/bin/env because an EnvironmentFile always
# overrides `Environment=` lines, and /etc/anfitorio/api.env carries
# RUN_SCHEDULERS=true for the API.
#
# Install:
#   sudo cp deploy/systemd/anfitorio-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now anfitorio-worker

[Unit]
Description=Anfitorio worker (pg-boss jobs, tsx runtime)
Documentation=file:///opt/anfitorio/hotelos/deploy/README-INSTALL.md
After=network-online.target postgresql.service anfitorio-api.service
Wants=network-online.target

[Service]
Type=simple
User=anfitorio
Group=anfitorio
WorkingDirectory=/opt/anfitorio/hotelos/apps/worker
Environment=NODE_ENV=production
Environment=COREPACK_ENABLE_DOWNLOAD_PROMPT=0
EnvironmentFile=/etc/anfitorio/api.env
ExecStart=/usr/bin/env RUN_SCHEDULERS=false /usr/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=anfitorio-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
