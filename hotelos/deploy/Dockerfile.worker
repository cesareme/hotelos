# Anfitorio worker · production image (pg-boss jobs: webhooks.deliver)
#
# Mirrors deploy/Dockerfile.api (pnpm 9.15.0 via corepack, frozen lockfile,
# Prisma client generated, tsx runtime). The worker only runs queue jobs; the
# in-process schedulers (SES, VeriFactu, pace, allotments, mailbox) live in
# the API instance with RUN_SCHEDULERS=true, so this container always runs
# with RUN_SCHEDULERS=false.
#
# Build context = the pnpm root (hotelos/):
#   docker build -f deploy/Dockerfile.worker -t anfitorio-worker .

# ---- stage 1: deps + prisma client ------------------------------------------
FROM node:22-bookworm-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY apps/admin-web/package.json ./apps/admin-web/
COPY apps/ai-gateway/package.json ./apps/ai-gateway/
COPY apps/api/package.json ./apps/api/
COPY apps/guest-web/package.json ./apps/guest-web/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/worker/package.json ./apps/worker/
COPY packages/ai-tools/package.json ./packages/ai-tools/
COPY packages/compliance/package.json ./packages/compliance/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/integrations/package.json ./packages/integrations/
COPY packages/onboarding/package.json ./packages/onboarding/
COPY packages/product/package.json ./packages/product/
COPY packages/revenue/package.json ./packages/revenue/
COPY packages/shared/package.json ./packages/shared/
COPY packages/ui/package.json ./packages/ui/

# No `--prod`: tsx is the official runtime (`node --import tsx`) but a
# devDependency of @hotelos/worker, and the Prisma CLI (devDependency of
# @hotelos/database) generates the client below, so the full tree is installed.
RUN pnpm install --frozen-lockfile --filter @hotelos/worker...

COPY packages ./packages
COPY apps/worker ./apps/worker

RUN pnpm --filter @hotelos/database db:generate

# ---- stage 2: runtime --------------------------------------------------------
FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

RUN groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder --chown=app:app /repo /app

USER app
ENV NODE_ENV=production
ENV RUN_SCHEDULERS=false
WORKDIR /app/apps/worker

ENTRYPOINT ["/usr/bin/tini", "--"]
# Same command as `pnpm --filter @hotelos/worker start`.
CMD ["node", "--import", "tsx", "src/index.ts"]
