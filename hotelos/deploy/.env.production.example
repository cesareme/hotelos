# Anfitorio · production environment for deploy/docker-compose.production.yml
#
# Usage:
#   cp deploy/.env.production.example deploy/.env.production
#   nano deploy/.env.production
#   docker compose -f deploy/docker-compose.production.yml --env-file deploy/.env.production up -d
#
# `docker compose --env-file` uses this file for ${VAR} interpolation only: a
# variable reaches a container solely when the compose `environment:` block
# forwards it. The 17 variables below are exactly the ones the production
# compose interpolates. REQUIRED = no default in the compose; the API refuses
# to boot (ENCRYPTION_KEY) or to authenticate anyone (JWT_SECRET) without a
# valid value. Keep this example free of real secrets: deploy/.env.production
# is gitignored and must never be committed.
#
# HOTELOS_ALLOW_DEMO_AUTH is PROHIBITED in production. Set to "true" it turns
# every unauthenticated request into the demo super-user (82 permissions,
# apps/api/src/lib/auth-context.ts). The production compose deliberately does
# not forward it, so do not add it to this file or to the compose: unset means
# default-deny (401). Only the local/dev .env may carry it.

# ---- Public endpoint -------------------------------------------------------
# REQUIRED. Hostname the DNS A record points at. Caddy (deploy/Caddyfile)
# issues and renews the Let's Encrypt certificate for it.
DOMAIN=app.example.com
# REQUIRED. Base URL the admin SPA calls. Baked into the admin-web image at
# build time (VITE_API_URL); Caddy serves the API under /api on the same
# origin, so it is normally https://$DOMAIN/api.
PUBLIC_API_URL=https://app.example.com/api

# ---- Postgres --------------------------------------------------------------
# Role and database created on the first boot of the postgres container. The
# api/worker DATABASE_URL is assembled from these three by the compose.
POSTGRES_USER=hotelos
POSTGRES_DB=hotelos
# REQUIRED. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Application secrets ---------------------------------------------------
# REQUIRED. Signs session JWTs. packages/database/src/jwt.ts rejects an empty
# value and the literal "change-me" at the first login.
# Generate: openssl rand -base64 48
JWT_SECRET=
# REQUIRED. AES-256-GCM key for guest PII fields; read as the HOTELOS_FIELD_KEY
# fallback in packages/database/src/crypto-fields.ts. Must be base64 that
# decodes to exactly 32 raw bytes, otherwise the API aborts boot in
# production. Rotating it makes already-encrypted PII unreadable: back up the
# database before changing it.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ---- Optional providers (empty = disabled, graceful fallback) --------------
# LLM provider key for the AI assistants (apps/api/src/lib/llm.ts). Empty
# keeps the rule-based fallbacks.
AI_PROVIDER_API_KEY=
# Forwarded to the api container for a future OCR adapter. No code reads it
# today (audit 2026-09-13 · DATA-04); leave empty.
OCR_PROVIDER_API_KEY=
# S3-compatible object storage (Hostinger Object Storage, AWS S3, Cloudflare
# R2). Forwarded to the api container for a future storage adapter; no code
# reads these four today (audit 2026-09-13 · DATA-04); leave empty.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Sentry project DSN. When set, api and worker report 5xx errors to Sentry.
SENTRY_DSN=

# ---- Spanish compliance submission modes -----------------------------------
# sandbox | preproduction | production. Stay on sandbox until the production
# certificates (AEAT for VeriFactu, Ministerio del Interior for SES
# Hospedajes) are installed and a round-trip has been tested against
# preproduction. Applies to both the api and the worker.
VERIFACTU_MODE=sandbox
SES_HOSPEDAJES_MODE=sandbox

# ---- Scheduling ------------------------------------------------------------
# The api service runs the in-process schedulers (SES, pace, allotment
# release, group cutoff, mailbox poll). Exactly ONE api replica may have this
# set to true; every additional replica must set false or AEAT / SES
# submissions get duplicated. The worker service is always false.
RUN_SCHEDULERS=true
