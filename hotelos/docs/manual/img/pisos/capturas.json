  {
    "_nota": "Cajón «Nueva tarea · Habitación 304» con «Limpieza a fondo» y prioridad «Baja» elegidas; NO se pulsa «Crear tarea».",
    "url": "/operaciones/pisos",
    "out": "docs/manual/img/pisos/nueva-tarea.png",
    "viewAs": "pisos",
    "hideCaret": true,
    "wait": 600,
    "selector": ".c22-drawer[data-open=\"true\"]",
    "actions": [
      {
        "click": "[role=\"group\"][aria-label=\"Habitación 304\"] >> text=Nueva tarea"
      },
      {
        "waitFor": ".c22-drawer[data-open=\"true\"]"
      },
      {
        "wait": 600
      },
      {
        "select": [
          "#hk-task-type",
          "deep_clean"
        ]
      },
      {
        "select": [
          ".c22-drawer select >> nth=1",
          "low"
        ]
      }
    ]
  },
  {
    "_nota": "Cajón «Reportar incidencia» de la PRIMERA habitación del turno (la lista de Mi turno cambia cada día, por eso la guía no cita el número) con el texto de la incidencia escrito; NO se pulsa «Enviar a mantenimiento».",
    "url": "/operaciones/pisos/mi-turno",
    "out": "docs/manual/img/pisos/reportar-incidencia.png",
    "viewAs": "pisos",
    "hideInstructions": true,
    "hideCaret": true,
    "wait": 600,
    "selector": ".c22-drawer[data-open=\"true\"]",
    "actions": [
      {
        "click": "[role=\"group\"][aria-label=\"Habitaciones del turno\"] [role=\"group\"][aria-label^=\"Habitación \"] >> nth=0 >> text=Reportar"
      },
      {
        "waitFor": ".c22-drawer[data-open=\"true\"]"
      },
      {
        "wait": 600
      },
      {
        "fill": [
          "#housekeeping-report",
          "MANUAL-PISOS- La lámpara de la mesilla derecha no enciende (bombilla o interruptor)."
        ]
      }
    ]
  }
]
