{
  "name": "@hotelos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/__tests__/*.test.mts\"",
    "lint": "eslint .",
    "backfill:pii": "tsx src/jobs/pii-backfill.ts",
    "rbac:sync": "node --env-file-if-exists=../../.env --import tsx src/scripts/rbac-sync.ts",
    "rbac:migrate-assignments": "node --env-file-if-exists=../../.env --import tsx src/scripts/rbac-migrate-assignments.ts",
    "backfill:snapshots": "node --env-file-if-exists=../../.env --import tsx src/scripts/backfill-snapshots.ts",
    "backfill:payment-hash": "node --env-file-if-exists=../../.env --import tsx src/scripts/backfill-payment-lookup-hash.ts",
    "backfill:taxes": "node --env-file-if-exists=../../.env --import tsx src/scripts/backfill-taxes.ts",
    "backfill:guest-register": "node --env-file-if-exists=../../.env --import tsx src/scripts/backfill-guest-register.ts",
    "demo:refresh": "node --env-file-if-exists=../../.env --import tsx src/scripts/refresh-demo-dataset.ts",
    "demo:fix-identity": "node --env-file-if-exists=../../.env --import tsx src/scripts/fix-demo-legal-identity.ts",
    "channels:seed-sandbox": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed-sandbox-channels.ts",
    "pilot:provision-property": "node --env-file-if-exists=../../.env --import tsx src/scripts/provision-pilot-property.ts",
    "structure:migrate-faranda-celuisma": "node --env-file-if-exists=../../.env --import tsx src/scripts/migrate-faranda-celuisma.ts",
    "payroll:import-cost": "node --env-file-if-exists=../../.env --import tsx src/scripts/import-payroll-cost.ts",
    "accounting:provision-chart": "node --env-file-if-exists=../../.env --import tsx src/scripts/accounting-provision-chart.ts",
    "accounting:replay": "node --env-file-if-exists=../../.env --import tsx src/scripts/accounting-replay.ts",
    "accounting:relabel-customer-account": "node --env-file-if-exists=../../.env --import tsx src/scripts/accounting-relabel-customer-account.ts",
    "import:pms-history-forecast": "node --env-file-if-exists=../../.env --import tsx src/scripts/import-pms-history-forecast.ts",
    "reservations:import": "node --env-file-if-exists=../../.env --import tsx src/scripts/import-reservations.ts",
    "ses:discard-failed": "node --env-file-if-exists=../../.env --import tsx src/scripts/discard-failed-ses-submissions.ts",
    "pms-shadow:pull": "node --env-file-if-exists=../../.env --import tsx src/scripts/pms-shadow-pull.ts",
    "sage200:import": "node --env-file-if-exists=../../.env --import tsx src/scripts/import-sage200.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@hotelos/ai-tools": "workspace:*",
    "@hotelos/compliance": "workspace:*",
    "@hotelos/config": "workspace:*",
    "@hotelos/database": "workspace:*",
    "@hotelos/product": "workspace:*",
    "@hotelos/revenue": "workspace:*",
    "@hotelos/shared": "workspace:*",
    "@prisma/client": "^6.7.0",
    "@sentry/node": "^10.55.0",
    "fastify": "^5.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "qrcode-terminal": "0.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
