# ehotelOS · entorno de desarrollo (.env en la raíz del monorepo)
#
# GENERADO por scripts/env-census.mjs a partir de apps/api/src/lib/env.ts
# (ENV_CONTRACT). No lo edites a mano: cambia el contrato y ejecuta
#   node scripts/env-census.mjs --write
# tests/env-contract.test.mjs falla si este fichero y el contrato divergen.
#
# Leyenda:
#   [REQ]         obligatoria siempre (el proceso no puede funcionar sin ella)
#   [PROD]        obligatoria con NODE_ENV=production (en dev solo avisa)
#   [OPT]         opcional, con valor por defecto seguro
#   [COND]        obligatoria cuando se cumple la condición indicada
#   [FISCAL-REAL] obligatoria al salir del modo sandbox de ese módulo fiscal
#   [TEST]        solo para tests automatizados; NUNCA en un despliegue accesible
# Cada clave indica su formato y, para secretos, cómo generarla. Ningún valor
# de ejemplo es un secreto real: los secretos van vacíos y hay que generarlos.
#
# Uso: cp .env.example .env && node scripts/validate-env.mjs .env
# El API y el worker cargan .env solo como valores por defecto: una variable ya
# definida en el entorno del proceso (compose, systemd, CI) siempre gana.

# ==== Proceso ===================================================================
# [OPT] Modo del proceso. Con production: RBAC estricto por defecto, la clave
# de cifrado de PII es obligatoria (aborta el arranque), se rechaza
# HOTELOS_ALLOW_DEMO_AUTH y las validaciones de este contrato son errores en
# vez de avisos. Otros valores (prod, Production…) se rechazan porque el
# código compara el literal.
# formato: enum development|test|production · por defecto: development
NODE_ENV=development
# [OPT] Puerto TCP del API (el ai-gateway usa 3100 por defecto).
# formato: entero ≥1 ≤65535 · por defecto: 3000
# PORT=
# [OPT] Interfaz de escucha. En un despliegue nativo detrás de Caddy usa
# 127.0.0.1 para no exponer el puerto 3000; el compose fuerza 0.0.0.0 (red
# interna de contenedores).
# formato: texto · por defecto: 0.0.0.0
# HOST=
# [OPT] Versión desplegada: se muestra en /health y es el valor por defecto de
# VERIFACTU_SYSTEM_VERSION.
# formato: texto · por defecto: dev
# APP_VERSION=
# [OPT] Nivel de log de Prisma. Sin definir: warn en producción e info en
# desarrollo.
# formato: enum off|query|info|warn|error · por defecto: info
# DATABASE_LOG_LEVEL=
# [OPT] Interruptor de la estructura societaria (Tanda 6b: Sociedad → Centros
# de trabajo). Con false el API se comporta como hotel individual: sin ámbito
# «Sociedad», sin oficina central en el switcher y las rutas /legal-entities y
# /organizations/me/structure responden 404. Las tablas, el backfill
# (backfill-legal-structure.ts) y resolveLegalIdentity no dependen de él.
# formato: true|false · por defecto: true
STRUCTURE_ENABLED=true

# ==== BD y colas ================================================================
# [REQ] Conexión Postgres de Prisma y pg-boss. En el compose de producción se
# ensambla desde POSTGRES_USER/PASSWORD/DB (déjala vacía ahí); en un
# despliegue nativo (systemd) es obligatoria.
# formato: postgresql://usuario:clave@host:5432/bd
DATABASE_URL=postgresql://hotelos:hotelos@localhost:5432/hotelos
# [OPT] Reservada: hoy no hay cliente Redis (el rate-limit es en memoria);
# solo se refleja en /health. El compose la fija a redis://redis:6379.
# formato: texto
REDIS_URL=redis://localhost:6379

# ==== Seguridad =================================================================
# [REQ] Firma los JWT de sesión. Vacía o con el valor de ejemplo el API
# arranca pero rechaza el primer login.
# formato: texto, ≥32 caracteres · generar: openssl rand -base64 48
JWT_SECRET=
# [PROD] Clave AES-256-GCM de los campos PII de huéspedes (fallback de
# HOTELOS_FIELD_KEY). En producción sin una clave válida el API aborta el
# arranque; en desarrollo avisa y guarda la PII en claro. Rotarla deja
# ilegible lo ya cifrado: haz backup antes.
# formato: base64 que decodifica a 32 bytes · generar: openssl rand -base64 32
# ENCRYPTION_KEY=
# [OPT] Clave de cifrado de campos PII con prioridad sobre ENCRYPTION_KEY.
# Cadena de fallback: HOTELOS_FIELD_KEY → ENCRYPTION_KEY.
# formato: base64 que decodifica a 32 bytes · generar: openssl rand -base64 32
# HOTELOS_FIELD_KEY=
# [OPT] Clave HMAC de los hashes de búsqueda por igualdad (email, documento).
# Fallback: HOTELOS_FIELD_KEY → ENCRYPTION_KEY. Acepta base64 o texto.
# formato: texto, ≥16 caracteres · generar: openssl rand -base64 32
# HOTELOS_LOOKUP_HASH_KEY=
# [OPT] Token del endpoint POST /onboarding/bootstrap (primera organización de
# una instalación real). Se desactiva solo en cuanto existe una organización.
# formato: texto, ≥32 caracteres · generar: openssl rand -hex 32
# BOOTSTRAP_TOKEN=

# ==== Auth/demo flags ===========================================================
# [OPT] true SOLO en dev/demo: toda petición sin token recibe el super-usuario
# demo. Con NODE_ENV=production el API se niega a arrancar (AUTH-04) salvo
# HOTELOS_ALLOW_DEMO_AUTH_UNSAFE_OVERRIDE=true. El demo local lo pone a true
# en su .env.
# formato: true|false · por defecto: false
HOTELOS_ALLOW_DEMO_AUTH=false
# [OPT] Escape PELIGROSO del guard anterior: permite
# HOTELOS_ALLOW_DEMO_AUTH=true en producción (demo pública sin datos reales).
# Nunca en un despliegue de cliente.
# formato: true|false · por defecto: false
# HOTELOS_ALLOW_DEMO_AUTH_UNSAFE_OVERRIDE=
# [OPT] RBAC estricto: un GET sin entrada en el manifiesto de permisos
# devuelve 403. Vacía = estricto en producción y fail-open con aviso en
# desarrollo. false está prohibido en producción.
# formato: true|false
# RBAC_STRICT=
# [TEST] Salta la sincronización del catálogo RBAC y la hidratación de tenants
# al arrancar. Solo tests.
# formato: true|false · por defecto: false
# TENANT_BOOTSTRAP_SKIP=

# ==== Rate limit/CORS ===========================================================
# [OPT] Peticiones por minuto y por usuario+IP antes de responder 429.
# formato: entero ≥1 ≤100000 · por defecto: 600
# RATE_LIMIT_MAX=
# [OPT] 1 detrás de Caddy/nginx para leer X-Forwarded-For; si no, el
# rate-limit agrupa todo en la IP del proxy. Solo se acepta el literal 1.
# formato: enum 0|1
# TRUST_PROXY=
# [OPT] Orígenes (scheme://host[:puerto]) autorizados por CORS, separados por
# comas. Fuera de producción se admiten además localhost/127.0.0.1 en
# cualquier puerto. Vacía en producción = solo same-origin (Caddy sirve SPA y
# API en el mismo origen).
# formato: lista separada por comas de orígenes http(s)://host[:puerto]
# CORS_ALLOWED_ORIGINS=
# [OPT] Solo desarrollo: true admite además los rangos privados 10/8,
# 172.16/12 y 192.168/16 (tablets del hotel contra un portátil). Ignorada en
# producción.
# formato: true|false · por defecto: false
# CORS_ALLOW_LAN=
# [OPT] OBSOLETA: alias de un único origen que se fusiona en
# CORS_ALLOWED_ORIGINS. Migra el valor allí.
# formato: origen http(s)://host[:puerto], sin barra final
# PILOT_PUBLIC_ORIGIN=
# [PROD] Origen público del admin-web: construye los enlaces /accept-invite y
# /reset-password de los emails. Sin barra final; https en producción.
# formato: origen http(s)://host[:puerto], sin barra final · por defecto:
# http://localhost:5173
APP_BASE_URL=http://localhost:5173
# [OPT] Origen público del portal de huéspedes (magic links). Sin barra final.
# formato: origen http(s)://host[:puerto], sin barra final · por defecto:
# http://localhost:5174
# GUEST_WEB_BASE_URL=
# [OPT] URL pública del API para los callbacks OAuth de las bandejas de correo
# (Gmail/Microsoft). Sin barra final.
# formato: URL http(s) · por defecto: http://localhost:3000
# API_PUBLIC_URL=

# ==== Email y mensajería ========================================================
# [OPT] Proveedor de email saliente (invitaciones, reset de contraseña, magic
# links). Vacío = envío simulado en desarrollo (la API devuelve el enlace) y
# 'disabled' en producción. Los tres EMAIL_* van juntos.
# formato: enum postmark|sendgrid
# EMAIL_PROVIDER=
# [COND] API key del proveedor de email.
# formato: texto · obligatoria si: EMAIL_PROVIDER
# EMAIL_PROVIDER_KEY=
# [COND] Remitente verificado en el proveedor (ej. no-reply@tu-hotel.com).
# formato: texto · obligatoria si: EMAIL_PROVIDER
# EMAIL_FROM=
# [OPT] SMS vía Twilio (con TWILIO_AUTH_TOKEN y TWILIO_FROM). Sin configurar:
# simulado en desarrollo, fallo explícito en producción.
# formato: texto
# TWILIO_ACCOUNT_SID=
# [COND] Auth token de la cuenta Twilio.
# formato: texto · obligatoria si: TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN=
# [COND] Número remitente en formato E.164 (+34600000000).
# formato: texto · obligatoria si: TWILIO_ACCOUNT_SID
# TWILIO_FROM=
# [OPT] WhatsApp Business (Meta Cloud API): id del número de teléfono.
# formato: texto
# WHATSAPP_PHONE_ID=
# [COND] Token Bearer de la Meta Cloud API.
# formato: texto · obligatoria si: WHATSAPP_PHONE_ID
# WHATSAPP_PROVIDER_TOKEN=
# [OPT] OBSOLETA: alias de WHATSAPP_PROVIDER_TOKEN.
# formato: texto
# WHATSAPP_TOKEN=
# [OPT] OAuth de Google para leer reservas desde una bandeja Gmail
# (integración de correo). Vacío = integración desactivada.
# formato: texto
# GMAIL_CLIENT_ID=
# [COND] Secreto OAuth de Google.
# formato: texto · obligatoria si: GMAIL_CLIENT_ID
# GMAIL_CLIENT_SECRET=
# [OPT] Callback OAuth registrado en Google. Por defecto API_PUBLIC_URL +
# /integrations/email/oauth/callback.
# formato: URL http(s)
# GMAIL_REDIRECT_URI=
# [OPT] OAuth de Microsoft 365 para la bandeja de reservas. Vacío =
# integración desactivada.
# formato: texto
# MS_CLIENT_ID=
# [COND] Secreto OAuth de Microsoft.
# formato: texto · obligatoria si: MS_CLIENT_ID
# MS_CLIENT_SECRET=
# [OPT] Tenant de Azure AD (common, organizations o el id del tenant).
# formato: texto · por defecto: common
# MS_TENANT=
# [OPT] Callback OAuth registrado en Azure. Por defecto API_PUBLIC_URL +
# /integrations/email/oauth/callback.
# formato: URL http(s)
# MS_REDIRECT_URI=

# ==== VeriFactu =================================================================
# [OPT] Envío a AEAT: sandbox (stub local), preproduction (entorno de pruebas
# oficial, ya requiere certificado y bloque SistemaInformatico) o production.
# Pasa por preproduction antes de production.
# formato: enum sandbox|preproduction|production · por defecto: sandbox
VERIFACTU_MODE=sandbox
# [FISCAL-REAL] NombreRazon del PRODUCTOR del software (titular de ehotelOS,
# no el hotel), según la declaración responsable
# (docs/compliance/verifactu-declaracion-responsable.md).
# formato: texto · obligatoria si: VERIFACTU_MODE!=sandbox
# VERIFACTU_SOFTWARE_NAME=
# [FISCAL-REAL] NIF del productor del software, con letra de control.
# formato: NIF/CIF español con letra de control · obligatoria si:
# VERIFACTU_MODE!=sandbox
# VERIFACTU_SOFTWARE_NIF=
# [OPT] NombreSistemaInformatico (≤30). Valor declarado ante la AEAT: en
# producción se fija al nombre de la declaración responsable vigente hasta
# firmar la nueva (docs/compliance/verifactu-declaracion-responsable.md §4.7).
# formato: texto · por defecto: ehotelOS
VERIFACTU_SYSTEM_NAME=ehotelOS
# [OPT] IdSistemaInformatico: código de exactamente 2 caracteres elegido por
# el productor.
# formato: texto, ≥2 caracteres · por defecto: 01
VERIFACTU_SYSTEM_ID=01
# [OPT] Versión declarada del sistema (≤50). Vacía = APP_VERSION y, en su
# defecto, 1.0.0. Fijarla a un semver declarable (§4.7).
# formato: texto
# VERIFACTU_SYSTEM_VERSION=
# [FISCAL-REAL] NumeroInstalacion (≤100): identificador que el productor
# asigna a esta instalación (no lo asigna AEAT). Desde la Tanda 6b el número
# de cada facturación vive en verifactu_installations (una fila por centro o
# por sociedad, inmutable); esta variable es solo el fallback en modo sandbox
# y el valor que el backfill hereda para las propiedades con envíos previos.
# En preproduction/production la ausencia de instalación es un error de
# readiness, nunca un fallback al env.
# formato: texto · obligatoria si: VERIFACTU_MODE!=sandbox
# VERIFACTU_INSTALL_NUMBER=
# [OPT] IndicadorMultiplesOT: S (SaaS multi-tenant) o N.
# formato: enum S|N · por defecto: S
VERIFACTU_MULTI_OT=S
# [FISCAL-REAL] Certificado de representante/sello en PKCS#12 (.p12/.pfx) para
# mTLS contra AEAT. En el compose los certificados se montan desde
# deploy/certs en /certs (p. ej. /certs/verifactu.p12).
# formato: ruta de fichero legible por el proceso · obligatoria si:
# VERIFACTU_MODE!=sandbox && !VERIFACTU_CERT_PATH
# VERIFACTU_CERT_P12=
# [OPT] Contraseña del PKCS#12 (fallback: VERIFACTU_CERT_PASSPHRASE).
# formato: texto
# VERIFACTU_CERT_P12_PASSPHRASE=
# [OPT] Opcional: PEM (clave privada + certificado) para la firma XAdES de
# auditoría guardada en verifactu_submissions. Sin PEM se guarda una firma
# stub. openssl pkcs12 -in cert.p12 -nodes -out sign.pem
# formato: ruta de fichero legible por el proceso
# VERIFACTU_SIGN_PEM=
# [OPT] Contraseña de la clave del PEM de firma (fallback:
# VERIFACTU_CERT_PASSPHRASE).
# formato: texto
# VERIFACTU_SIGN_PEM_PASSPHRASE=
# [OPT] Compatibilidad: un único fichero (PEM o PKCS#12, se detecta) para mTLS
# y firma. Ignorado cuando VERIFACTU_CERT_P12 / VERIFACTU_SIGN_PEM están
# definidos.
# formato: ruta de fichero legible por el proceso
# VERIFACTU_CERT_PATH=
# [OPT] Contraseña del fichero de VERIFACTU_CERT_PATH y fallback de las dos
# anteriores.
# formato: texto
# VERIFACTU_CERT_PASSPHRASE=
# [OPT] Reintentos por registro antes de marcarlo fallido (terminal).
# formato: entero ≥1 ≤100 · por defecto: 12
# VERIFACTU_MAX_ATTEMPTS=
# [OPT] Añade sello de tiempo (TSA) a las firmas XAdES de auditoría.
# formato: true|false · por defecto: false
# XADES_TIMESTAMP_ENABLED=
# [OPT] real llama a la TSA de XADES_TIMESTAMP_TSA_URL; stub genera un sello
# local.
# formato: enum stub|real · por defecto: stub
# XADES_TIMESTAMP_MODE=
# [OPT] URL de la autoridad de sellado de tiempo (RFC 3161).
# formato: URL http(s) · por defecto: http://timestamp.digicert.com
# XADES_TIMESTAMP_TSA_URL=

# ==== SES =======================================================================
# [OPT] Partes de viajeros al Ministerio del Interior (SES.Hospedajes):
# sandbox (stub), preproduction o production. Fuera de sandbox exige
# certificado y credenciales.
# formato: enum sandbox|preproduction|production · por defecto: sandbox
SES_HOSPEDAJES_MODE=sandbox
# [FISCAL-REAL] Certificado electrónico cualificado registrado en el MIR
# (PKCS#12); en el compose /certs/ses-hospedajes.p12.
# formato: ruta de fichero legible por el proceso · obligatoria si:
# SES_HOSPEDAJES_MODE!=sandbox
# SES_HOSPEDAJES_CERT_PATH=
# [FISCAL-REAL] Contraseña del certificado SES.
# formato: texto · obligatoria si: SES_HOSPEDAJES_MODE!=sandbox
# SES_HOSPEDAJES_CERT_PASSPHRASE=
# [FISCAL-REAL] Usuario de la API de comunicaciones SES.Hospedajes.
# formato: texto · obligatoria si: SES_HOSPEDAJES_MODE!=sandbox
# SES_HOSPEDAJES_CLIENT_ID=
# [FISCAL-REAL] Contraseña de la API SES.Hospedajes.
# formato: texto · obligatoria si: SES_HOSPEDAJES_MODE!=sandbox
# SES_HOSPEDAJES_CLIENT_SECRET=
# [OPT] Reintentos por comunicación antes de marcarla fallida.
# formato: entero ≥1 ≤100 · por defecto: 10
# SES_MAX_ATTEMPTS=

# ==== TBAI ======================================================================
# [OPT] TicketBAI (País Vasco): solo si la propiedad tributa allí. NO existe
# preproduction: cualquier valor distinto de production se trata como sandbox,
# así que se rechaza para evitar sorpresas.
# formato: enum sandbox|production · por defecto: sandbox
TBAI_MODE=sandbox
# [FISCAL-REAL] Certificado de dispositivo/entidad TicketBAI (PKCS#12).
# formato: ruta de fichero legible por el proceso · obligatoria si:
# TBAI_MODE=production
# TBAI_CERT_PATH=
# [FISCAL-REAL] Contraseña del certificado TicketBAI.
# formato: texto · obligatoria si: TBAI_MODE=production
# TBAI_CERT_PASSPHRASE=
# [FISCAL-REAL] LicenciaTBAI concedida por la diputación foral (≤20).
# formato: texto · obligatoria si: TBAI_MODE=production
# TBAI_LICENSE_KEY=
# [OPT] NumSerieDispositivo (≤30). Vacío = número de la instalación TicketBAI
# declarada del centro (verifactu_installations, route tbai), después
# VERIFACTU_INSTALL_NUMBER; en TBAI_MODE=production la ausencia de instalación
# bloquea el envío.
# formato: texto
# TBAI_DEVICE_SERIAL=

# ==== IGIC ======================================================================
# [OPT] IGIC (Canarias): solo si la propiedad tributa allí. sandbox,
# preproduction o production.
# formato: enum sandbox|preproduction|production · por defecto: sandbox
IGIC_MODE=sandbox
# [FISCAL-REAL] Certificado para la Agencia Tributaria Canaria (PKCS#12).
# formato: ruta de fichero legible por el proceso · obligatoria si:
# IGIC_MODE!=sandbox
# IGIC_CERT_PATH=
# [FISCAL-REAL] Contraseña del certificado IGIC.
# formato: texto · obligatoria si: IGIC_MODE!=sandbox
# IGIC_CERT_PASSPHRASE=

# ==== Schedulers ================================================================
# [OPT] Esta instancia ejecuta los schedulers in-process (SES, VeriFactu,
# pace, cupos, grupos, buzón, modo sombra OPERA). En multi-réplica solo UNA a
# true o se duplican envíos a AEAT. El worker la ignora (siempre false).
# formato: true|false · por defecto: true
RUN_SCHEDULERS=true
# [OPT] true desactiva el envío periódico de partes SES.
# formato: true|false · por defecto: false
# SES_SCHEDULER_DISABLED=
# [OPT] Periodo del scheduler SES (ms).
# formato: entero ≥10000 ≤86400000 · por defecto: 300000
# SES_SCHEDULER_INTERVAL_MS=
# [OPT] true desactiva el envío periódico de registros VeriFactu.
# formato: true|false · por defecto: false
# VERIFACTU_SCHEDULER_DISABLED=
# [OPT] Periodo del scheduler VeriFactu (ms).
# formato: entero ≥10000 ≤86400000 · por defecto: 120000
# VERIFACTU_SCHEDULER_INTERVAL_MS=
# [OPT] true desactiva el cálculo diario de pace/night-audit.
# formato: true|false · por defecto: false
# PACE_SCHEDULER_DISABLED=
# [OPT] true desactiva la liberación automática de cupos.
# formato: true|false · por defecto: false
# ALLOTMENT_RELEASE_SCHEDULER_DISABLED=
# [OPT] true desactiva el cutoff automático de grupos.
# formato: true|false · por defecto: false
# GROUP_CUTOFF_SCHEDULER_DISABLED=
# [OPT] true desactiva el sondeo de las bandejas de correo integradas.
# formato: true|false · por defecto: false
# MAILBOX_POLL_DISABLED=
# [OPT] Periodo del sondeo de buzones (ms).
# formato: entero ≥10000 ≤86400000 · por defecto: 300000
# MAILBOX_POLL_INTERVAL_MS=
# [OPT] Periodo (ms) del drenaje del outbox de canales (ChannelDelivery →
# adaptadores). Solo corre en el líder de schedulers (RUN_SCHEDULERS).
# formato: entero ≥10000 ≤86400000 · por defecto: 15000
# CHANNEL_DRAIN_INTERVAL_MS=
# [OPT] true desactiva el drenaje automático del outbox de canales (las
# entregas quedan en cola; POST /channel-manager/deliveries/drain sigue
# disponible).
# formato: true|false · por defecto: false
# CHANNEL_DRAIN_DISABLED=
# [OPT] Máximo de entregas (ChannelDelivery) que toma cada pasada del drenaje.
# formato: entero ≥10 ≤20000 · por defecto: 2000
# CHANNEL_DRAIN_BATCH_LIMIT=
# [OPT] Días que se conservan las entregas de canal sustituidas
# (ChannelDelivery status superseded); las más antiguas las purga la pasada de
# drenaje del líder (como máximo una vez por hora). El resto de estados nunca
# se purga.
# formato: entero ≥1 ≤3650 · por defecto: 30
# CHANNEL_DELIVERY_RETENTION_DAYS=
# [OPT] true desactiva el job del modo sombra OPERA (alertas OPERA_FEED_LATE y
# cierre de runs interrumpidos). Solo actúa en el líder (RUN_SCHEDULERS).
# formato: true|false · por defecto: false
# PMS_SHADOW_JOB_DISABLED=
# [OPT] Periodo del job del modo sombra OPERA (ms); por defecto 15 minutos.
# formato: entero ≥10000 ≤86400000 · por defecto: 900000
# PMS_SHADOW_JOB_INTERVAL_MS=
# [OPT] Agente pms-shadow:pull (VPS): origen del API o URL completa de POST
# /integrations/pms-shadow/ingest; equivale a --ingest-url.
# formato: URL http(s)
# PMS_SHADOW_INGEST_URL=
# [OPT] Agente pms-shadow:pull (VPS): clave <clientId>.<clientSecret> de la
# DeveloperApp con scope pms.shadow.ingest; equivale a --api-key (preferible
# al flag: no queda en ps ni en el historial).
# formato: texto
# PMS_SHADOW_API_KEY=

# ==== IA ========================================================================
# [OPT] Proveedor LLM de los asistentes. none = respuestas basadas en reglas.
# Sin este valor la API key no sirve.
# formato: enum none|anthropic|openai · por defecto: none
# AI_PROVIDER=
# [COND] API key del proveedor LLM.
# formato: texto · obligatoria si: AI_PROVIDER!=none
# AI_PROVIDER_API_KEY=
# [OPT] Modelo a usar. Vacío = claude-3-5-sonnet-latest (anthropic) o
# gpt-4o-mini (openai).
# formato: texto
# AI_MODEL=
# [OPT] Timeout de cada llamada al LLM (ms).
# formato: entero ≥1000 ≤600000 · por defecto: 20000
# AI_REQUEST_TIMEOUT_MS=
# [OPT] Motor de onboarding con IA: stub (en proceso) o real (llama al
# ai-gateway).
# formato: enum stub|real · por defecto: stub
# AI_GATEWAY_MODE=
# [OPT] URL del ai-gateway cuando AI_GATEWAY_MODE=real.
# formato: URL http(s) · por defecto: http://localhost:4000
# AI_GATEWAY_URL=
# [OPT] Solo la lee el ai-gateway: URL del API contra el que ejecuta las
# herramientas.
# formato: URL http(s) · por defecto: http://localhost:3000
# API_BASE_URL=
# [OPT] Reservada: solo el /health del ai-gateway la refleja como
# configured/unconfigured.
# formato: texto
# OCR_PROVIDER_API_KEY=
# [OPT] Reservada: solo el /health del ai-gateway la refleja como
# configured/unconfigured.
# formato: texto
# SPEECH_PROVIDER_API_KEY=

# ==== OTA =======================================================================
# [OPT] Tope del modo de los canales (Channel.mode): stub (simulador, sin
# credenciales), sandbox (simulador local con validación estructural del
# payload; por defecto) o real (HTTPS al proveedor; exige credenciales
# reales). Nada sale a Internet sin real.
# formato: enum stub|sandbox|real · por defecto: sandbox
CHANNEL_MAX_MODE=sandbox
# [OPT] Base de la API de Channex (agregador). staging.channex.io para
# certificación; app.channex.io en producción. La api key va por canal
# (credenciales cifradas).
# formato: URL http(s) · por defecto: https://staging.channex.io
CHANNEX_BASE_URL=https://staging.channex.io
# [OPT] Base de la API real de Booking (vacío = por defecto del adaptador).
# formato: URL http(s)
# BOOKING_API_BASE_URL=
# [OPT] Endpoint de token exchange JWT de Booking Connectivity (por defecto
# https://connectivity-authentication.booking.com/token-based-authentication/exchange).
# formato: URL http(s)
# BOOKING_OAUTH_URL=
# [OPT] Base de la API de Expedia (vacío = por defecto).
# formato: URL http(s)
# EXPEDIA_API_BASE_URL=

# ==== Pagos =====================================================================
# [OPT] Fuerza el PSP de todos los cobros en línea (stripe | redsys). Vacío =
# la conexión «connected» de la propiedad y, si no hay, el primer proveedor
# con credenciales (Stripe, luego Redsys).
# formato: enum stripe|redsys
# PAYMENTS_PSP_PROVIDER=
# [OPT] Origen público al que el PSP redirige al cliente tras pagar y donde
# envía las notificaciones (/payments/webhooks/:provider). Vacío =
# API_PUBLIC_URL. Sin barra final.
# formato: origen http(s)://host[:puerto], sin barra final
# PAYMENTS_PUBLIC_BASE_URL=
# [OPT] Clave secreta de Stripe. sk_test_… = sandbox real de Stripe (llamadas
# HTTPS a api.stripe.com en modo test); sk_live_… = producción. Vacío = Stripe
# no configurado (409 PSP_NOT_CONFIGURED).
# formato: texto
# STRIPE_SECRET_KEY=
# [COND] Secreto de firma del endpoint de webhooks de Stripe (whsec_…). Sin él
# ningún webhook de Stripe se acepta: un cobro en línea nunca pasa a
# «captured».
# formato: texto · obligatoria si: STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=
# [OPT] Código de comercio (FUC, 9 dígitos) del TPV Virtual de Redsys. Vacío =
# Redsys no configurado.
# formato: texto
# REDSYS_MERCHANT_CODE=
# [OPT] Número de terminal del TPV Virtual de Redsys (normalmente 001).
# formato: texto · por defecto: 001
# REDSYS_TERMINAL=
# [COND] Clave secreta (base64, 24 bytes) del comercio en Redsys: deriva la
# clave de cada operación con 3DES y firma HMAC-SHA256 (HMAC_SHA256_V1).
# formato: texto · obligatoria si: REDSYS_MERCHANT_CODE
# REDSYS_SECRET_KEY=
# [OPT] Entorno del SIS de Redsys: test (sis-t.redsys.es, sin dinero real) o
# live (sis.redsys.es).
# formato: enum test|live · por defecto: test
# REDSYS_MODE=

# ==== Wallet ====================================================================
# [OPT] Pass Type ID de las llaves móviles en Apple Wallet.
# formato: texto · por defecto: pass.com.hotelos.roomkey
# APPLE_WALLET_PASS_TYPE_ID=
# [OPT] Team ID de Apple Developer. El valor por defecto es de desarrollo: en
# producción avisa si sigue ahí.
# formato: texto · por defecto: HOTELOSDEV
# APPLE_WALLET_TEAM_ID=
# [OPT] Certificado de firma de pases; definido = los pases salen firmados.
# formato: ruta de fichero legible por el proceso
# APPLE_WALLET_CERT_PATH=
# [OPT] Issuer ID de Google Wallet (el valor por defecto es de pruebas).
# formato: texto · por defecto: 3388000000022000000
# GOOGLE_WALLET_ISSUER_ID=

# ==== Sentry ====================================================================
# [OPT] DSN de Sentry del API/worker: captura errores 5xx. Vacío = desactivado
# (en producción avisa).
# formato: URL http(s)
# SENTRY_DSN=
# [OPT] DSN de Sentry del admin-web (se hornea en el build de Vite).
# formato: URL http(s)
# VITE_SENTRY_DSN=

# ==== Frontend ==================================================================
# [OPT] URL del API que llama el admin-web; se hornea en el build (vite
# build). En producción https://<host>/api. Sin barra final.
# formato: URL http(s) · por defecto: http://localhost:3000
# VITE_API_URL=
# [OPT] Versión mostrada en la ayuda del admin-web.
# formato: texto · por defecto: 0.1.0
# VITE_APP_VERSION=
# [OPT] URL del API para la app móvil (Expo).
# formato: URL http(s)
# EXPO_PUBLIC_API_BASE_URL=
# [OPT] URL del admin-web que abre la app móvil desde Más.
# formato: URL http(s)
# EXPO_PUBLIC_ADMIN_WEB_URL=
# [OPT] Muestra el lanzador de entornos de desarrollo en la app móvil.
# formato: true|false · por defecto: false
# EXPO_PUBLIC_SHOW_DEV_LAUNCHER=

# ==== Seeds =====================================================================
# [OPT] Organización destino de los seeds demo (db:seed:*). Solo
# desarrollo/demo.
# formato: texto · por defecto: org_123
# SEED_ORG_ID=
# [OPT] Propiedad destino de los seeds demo.
# formato: texto · por defecto: prop_123
# SEED_PROPERTY_ID=
# [OPT] Alcance del seed comercial: full o solo rates.
# formato: enum full|rates · por defecto: full
# SEED_SCOPE=
# [OPT] Precios BAR por categoría para el seed comercial (formato del seed).
# formato: texto
# SEED_BAR_PRICES=
# [OPT] Días hacia atrás de la rejilla de tarifas sembrada.
# formato: entero ≥0 ≤3650 · por defecto: 30
# SEED_RATE_DAYS_BACK=
# [OPT] Días hacia delante de la rejilla de tarifas sembrada.
# formato: entero ≥0 ≤3650 · por defecto: 150
# SEED_RATE_DAYS_AHEAD=
# [OPT] db:seed:snapshots: el literal 1 permite crear habitaciones demo en una
# propiedad de la allowlist que no tenga ninguna; sin él la propiedad se
# omite.
# formato: enum 1
# SEED_CREATE_ROOMS=
# [OPT] Guard DATA-05: los seeds solo escriben sobre la allowlist demo
# (org_123, prop_123, prop_canary). Para apuntar a otro objetivo exporta el
# literal 1 junto con SEED_CONFIRM=<id>. Nunca en un .env persistente.
# formato: enum 1
# SEED_ALLOW_REAL=
# [OPT] Guard DATA-05: id exacto (o lista separada por comas) de la
# organización/propiedad NO demo que confirmas como objetivo del seed; solo se
# honra con SEED_ALLOW_REAL=1.
# formato: texto
# SEED_CONFIRM=

# ==== Tests =====================================================================
# [TEST] Devuelve el token de reset de contraseña en la respuesta HTTP para
# poder testearlo. NUNCA en un despliegue accesible.
# formato: true|false · por defecto: false
AUTH_EXPOSE_RESET_TOKEN=false
# [TEST] Devuelve la contraseña temporal en claro en la consola super-admin.
# NUNCA en un despliegue accesible.
# formato: true|false · por defecto: false
ADMIN_EXPOSE_TEMP_PASSWORD=false
# [TEST] Devuelve el token del portal de huéspedes por HTTP aunque el magic
# link se haya entregado por email. NUNCA en producción.
# formato: true|false · por defecto: false
GUEST_PORTAL_RETURN_TOKEN=false
# [TEST] false evita que el worker arranque el scheduler al importarlo (solo
# tests).
# formato: true|false · por defecto: true
# WORKER_AUTOSTART=
# [OPT] scripts/smoke-director-dashboard.mjs: URL del API a probar.
# formato: URL http(s) · por defecto: http://localhost:3000
# API_URL=
# [OPT] scripts/smoke-director-dashboard.mjs: URL del admin-web.
# formato: URL http(s) · por defecto: http://localhost:5173
# ADMIN_WEB_URL=
# [OPT] scripts/smoke-director-dashboard.mjs: propiedad del smoke.
# formato: texto · por defecto: prop_123
# DEMO_PROPERTY_ID=
# [OPT] scripts/smoke-director-dashboard.mjs: timeout por petición (ms).
# formato: entero ≥1000 ≤600000 · por defecto: 15000
# SMOKE_TIMEOUT_MS=
