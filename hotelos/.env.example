DATABASE_URL=postgresql://hotelos:hotelos@localhost:5432/hotelos
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
# audit 2026-06 R2 · #7: set to "true" ONLY in dev/demo environments.
# When false (default), unauthenticated requests are rejected with 401
# regardless of NODE_ENV. Production compose must NOT set this to true.
# AUTH-04 (audit 2026-09-13): with NODE_ENV=production the API REFUSES TO BOOT
# while this is "true" (apps/api/src/lib/auth-context.ts, assertDemoAuthPolicy).
HOTELOS_ALLOW_DEMO_AUTH=true
# DANGEROUS escape hatch for the guard above, and the only way to run the demo
# fallback under NODE_ENV=production: every request without a token becomes the
# demo super-user. Acceptable solely on a public demo box with no real tenant
# data. Never set it in deploy/.env.production; scripts/validate-env.mjs flags it.
# HOTELOS_ALLOW_DEMO_AUTH_UNSAFE_OVERRIDE=true
# AUTH-03: RBAC strict mode. Every API route must have an entry in
# apps/api/src/security/route-permissions.ts; in strict mode a GET without one
# is refused (403) instead of being served as public. Default: strict when
# NODE_ENV=production, fail-open with a logged warning otherwise. Leave it
# unset to inherit that default; set "true" locally to reproduce production.
# RBAC_STRICT=false is an explicit opt-out that validate-env rejects for
# production files. CI enforces that every registered route is in the manifest.
# RBAC_STRICT=true
ENCRYPTION_KEY=change-me-32-bytes
OBJECT_STORAGE_BUCKET=hotelos-dev
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
AI_PROVIDER_API_KEY=change-me
OCR_PROVIDER_API_KEY=change-me
SPEECH_PROVIDER_API_KEY=change-me
PAYMENT_PROVIDER_SECRET=change-me
WHATSAPP_PROVIDER_TOKEN=change-me
# --- Email saliente (invitaciones de usuario, reset de contraseña, magic links) ---
# Los tres son necesarios para enviar de verdad. Sin ellos (o con la clave
# "change-me") el dispatcher SIMULA el envío fuera de producción (la entrega se
# registra como "SIMULADO" y la API devuelve el enlace de invitación para
# entregarlo a mano) y en producción lo marca como fallido/'disabled'.
# GET /notifications/email-status expone el modo real|simulated|disabled.
# EMAIL_PROVIDER: postmark | sendgrid
EMAIL_PROVIDER=
EMAIL_PROVIDER_KEY=change-me
# Remitente verificado en el proveedor (ej: no-reply@tu-hotel.com).
EMAIL_FROM=
# Origen público del admin-web: construye los enlaces /accept-invite?token= y
# /reset-password?token= de los emails. Sin barra final.
APP_BASE_URL=http://localhost:5173
SES_HOSPEDAJES_CLIENT_ID=change-me
SES_HOSPEDAJES_CLIENT_SECRET=change-me
# Compliance ES · modos de envío (sandbox|preproduction|production)
# Para go-live real, cambia a preproduction primero y prueba contra el entorno
# de pruebas oficial antes de pasar a production.
VERIFACTU_MODE=sandbox
# --- VeriFactu · certificados (Tanda 3) ---
# mTLS contra AEAT: certificado de representante/sello en PKCS#12 (.p12/.pfx).
VERIFACTU_CERT_P12=
VERIFACTU_CERT_P12_PASSPHRASE=
# Firma XAdES de auditoría (opcional): PEM con PRIVATE KEY + CERTIFICATE.
# En la modalidad VERI*FACTU el registro NO va firmado (la integridad la da la
# huella encadenada; el canal se autentica por mTLS); la firma solo se guarda
# en verifactu_submissions.xml_payload. Sin PEM se guarda una firma stub.
#   openssl pkcs12 -in cert.p12 -nodes -out sign.pem
VERIFACTU_SIGN_PEM=
VERIFACTU_SIGN_PEM_PASSPHRASE=
# Compatibilidad: un único fichero para ambos usos. Se detecta el formato:
# PEM sirve para mTLS y firma; PKCS#12 solo para mTLS (aviso en readiness).
# Ignorado cuando VERIFACTU_CERT_P12 / VERIFACTU_SIGN_PEM están definidos.
VERIFACTU_CERT_PATH=
VERIFACTU_CERT_PASSPHRASE=
# --- VeriFactu · bloque SistemaInformatico (Orden HAC/1177/2024, anexo) ---
# Identifica al PRODUCTOR del software (la empresa titular de Anfitorio), NO al
# hotel emisor. Todos los valores deben coincidir con la declaración responsable
# (docs/compliance/verifactu-declaracion-responsable.md). Cadena vacía = no
# configurado: en preproduction/production no se envía nada hasta completarlo
# (fila parked con SOFTWARE_NOT_CONFIGURED); en sandbox se usan defaults etiquetados.
# NombreRazon del productor (≤120 caracteres). Obligatorio.
VERIFACTU_SOFTWARE_NAME=
# NIF del productor (validado con letra de control). Obligatorio.
VERIFACTU_SOFTWARE_NIF=
# NombreSistemaInformatico (≤30). Por defecto "Anfitorio".
VERIFACTU_SYSTEM_NAME=Anfitorio
# IdSistemaInformatico: código de 2 caracteres elegido por el productor. Por defecto "01".
VERIFACTU_SYSTEM_ID=01
# Version declarada (≤50). Si no se define se usa APP_VERSION y, en su defecto, "0.1.0".
VERIFACTU_SYSTEM_VERSION=
# NumeroInstalacion (≤100): identificador que el PRODUCTOR asigna a esta
# instalación/despliegue (no lo asigna AEAT). Obligatorio.
VERIFACTU_INSTALL_NUMBER=
# TipoUsoPosibleMultiOT / IndicadorMultiplesOT: S (SaaS multi-tenant, valor por defecto) | N.
VERIFACTU_MULTI_OT=S
SES_HOSPEDAJES_MODE=sandbox
SES_HOSPEDAJES_CERT_PATH=
SES_HOSPEDAJES_CERT_PASSPHRASE=
TBAI_MODE=sandbox
TBAI_CERT_PATH=
TBAI_CERT_PASSPHRASE=
IGIC_MODE=sandbox
IGIC_CERT_PATH=
IGIC_CERT_PASSPHRASE=
APP_PUBLIC_API_URL=http://localhost:3000
# Sentry (vacío = desactivado). Si lo defines, captura errores 5xx en API.
SENTRY_DSN=
# Sentry para admin-web (Vite, inyectado en build).
VITE_SENTRY_DSN=
# Origen público del frontend para CORS en piloto (ej: https://pilot.acme-hotel.com).
PILOT_PUBLIC_ORIGIN=
# Token para el endpoint POST /onboarding/bootstrap (first-run piloto).
# Genera con: openssl rand -hex 32. Después del primer arranque queda obsoleto
# (la guard `count(Organization) === 0` desactiva el endpoint automáticamente).
BOOTSTRAP_TOKEN=

# --- Schedulers (SES, VeriFactu, pace/night-audit, cupos, grupos, buzón) ---
# En multi-réplica solo UNA instancia debe ejecutarlos (evita envíos duplicados a AEAT).
RUN_SCHEDULERS=true
# Desactivan schedulers concretos (útil en tests o instancias secundarias).
PACE_SCHEDULER_DISABLED=false
VERIFACTU_SCHEDULER_DISABLED=false
# Reintentos máximos por registro VeriFactu antes de marcarlo como fallido (terminal).
VERIFACTU_MAX_ATTEMPTS=12

# --- Flags SOLO para tests automatizados (NUNCA en un despliegue accesible por red) ---
# Devuelve el token de reset de contraseña en la respuesta HTTP para poder testearlo.
AUTH_EXPOSE_RESET_TOKEN=false
# Devuelve la contraseña temporal EN CLARO en POST /admin/tenants y
# .../reset-password (consola super-admin). Por defecto la API solo devuelve el
# enlace de invitación (user_invitations, un solo uso, 72 h) y nunca la clave.
ADMIN_EXPOSE_TEMP_PASSWORD=false

