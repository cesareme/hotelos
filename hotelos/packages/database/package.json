{
  "name": "@hotelos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:status": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate status",
    "db:adopt-baseline": "node --env-file-if-exists=../../.env scripts/adopt-baseline.mjs",
    "db:push": "prisma db push --skip-generate",
    "db:drift:check": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:seed:commercial": "node --env-file=../../.env --import tsx prisma/seed-commercial-demo.ts",
    "db:seed:snapshots": "node --env-file=../../.env --import tsx prisma/seed-revenue-snapshots.ts",
    "db:seed:compliance": "node --env-file=../../.env --import tsx prisma/seed-compliance.ts",
    "db:seed:operations": "node --env-file=../../.env --import tsx prisma/seed-operations.ts",
    "db:seed:cancellation": "node --env-file=../../.env --import tsx prisma/seed-cancellation-policies.ts",
    "db:seed:allotments": "node --env-file=../../.env --import tsx prisma/seed-allotments.ts",
    "db:seed:fnb": "node --env-file=../../.env --import tsx prisma/seed-fnb-inventory.ts",
    "db:seed:enrich": "node --env-file=../../.env --import tsx seeds/demo-pre-demo-enrichment.mjs",
    "db:seed:rbac-demo": "node --env-file=../../.env --import tsx prisma/seed-rbac-demo.ts",
    "db:seed:ux-day": "node --env-file=../../.env --import tsx prisma/seed-ux-day.ts",
    "db:seed:ux-direccion": "node --env-file=../../.env --import tsx prisma/seed-ux-direccion.ts",
    "db:seed:checkin": "node --env-file=../../.env --import tsx prisma/seed-checkin.ts",
    "db:seed:real-estate": "node --env-file=../../.env --import tsx prisma/seed-real-estate.ts",
    "db:seed:hr": "node --env-file=../../.env --import tsx prisma/seed-hr.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:seed:ux-day-pisos": "node --env-file=../../.env --import tsx prisma/seed-ux-day-pisos.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
