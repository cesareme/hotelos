  providerMessageId String?   @map("provider_message_id")
  subject           String?
  bodyRendered      String?   @db.Text @map("body_rendered")
  payloadJson       Json?     @map("payload_json")
  attempts          Int       @default(0)
  errorMessage      String?   @map("error_message")
  scheduledFor      DateTime? @map("scheduled_for")
  sentAt            DateTime? @map("sent_at")
  failedAt          DateTime? @map("failed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([propertyId, status, scheduledFor])
  @@index([channel, status])
  @@map("notification_deliveries")
}

// ===========================================================================
// Compliance Center — regulatory compliance matrix for Spanish hotels.
// Areas + requirement catalog (jurisdiction-aware) → per-property items with
// status semaphore, documents, tasks. Keyed by stable codes (area/requirement).
// ===========================================================================

model ComplianceArea {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("compliance_areas")
}

model ComplianceRequirement {
  id                       String   @id @default(cuid())
  areaCode                 String   @map("area_code")
  code                     String   @unique
  title                    String
  description              String?
  jurisdiction             String   @default("STATE")
  autonomousCommunity      String?  @map("autonomous_community")
  municipality             String?
  legalReference           String?  @map("legal_reference")
  appliesWhen              String?  @map("applies_when")
  appliesRule              String?  @map("applies_rule")
  defaultApplies           Boolean  @default(true) @map("default_applies")
  hotelTypes               String[] @default([]) @map("hotel_types")
  riskLevel                String   @default("MEDIUM")
  requiredDocuments        String[] @map("required_documents")
  renewalRequired          Boolean  @default(false) @map("renewal_required")
  defaultRenewalPeriodDays Int?     @map("default_renewal_period_days")
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([areaCode])
  @@map("compliance_requirements")
}

model CompliancePropertyProfile {
