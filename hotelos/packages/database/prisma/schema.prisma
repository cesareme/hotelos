  clean
  dirty
  inspected
  occupied
  out_of_order
  out_of_service
}

enum ReservationStatus {
  draft
  confirmed
  checked_in
  checked_out
  cancelled
  no_show
}

enum FolioStatus {
  open
  closed
}

enum PaymentStatus {
  pending
  captured
  refunded
  failed
}

enum InvoiceStatus {
  draft
  issued
  cancelled
  rectified
}

enum JournalStatus {
