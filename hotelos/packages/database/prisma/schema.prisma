/// Estándar de dotación por centro × departamento USALI × driver (diseño §6.2): minutos por unidad, puestos por tramo, FTE por 100 habitaciones…
model LaborStandard {
  id              String    @id @default(cuid())
  propertyId      String    @map("property_id")
  usaliDepartment String    @map("usali_department")
  /// occupied_rooms · departures · stayovers · arrivals · pax · covers_breakfast · covers_restaurant · rooms_inventory · fixed
  driver          String
  /// minutes_per_unit · units_per_shift · fte_per_100 · posts_by_band
  unit            String
  value           Decimal   @db.Decimal(10, 3)
  /// Tramos para posts_by_band, p. ej. [{ "maxOccupiedRooms": 60, "posts": [1, 1, 1] }].
  bandsJson       Json?     @map("bands_json")
  /// Suplementos (descansos, carro, desplazamientos) en %; 0 si no aplica.
  allowancePct    Decimal   @default(0) @map("allowance_pct") @db.Decimal(5, 2)
  /// Factor de cobertura (7 días, descansos, absentismo): 1,4 por defecto.
  coverageFactor  Decimal   @default(1.4) @map("coverage_factor") @db.Decimal(5, 2)
  validFrom       DateTime  @map("valid_from")
  validTo         DateTime? @map("valid_to")
  /// sector_default · measured · agreement
  source          String    @default("sector_default")
