  propertyId          String   @unique @map("property_id")
  autonomousCommunity String?  @map("autonomous_community")
  hotelType           String?  @map("hotel_type")
  hasRestaurant     Boolean  @default(false) @map("has_restaurant")
  hasKitchen        Boolean  @default(false) @map("has_kitchen")
  hasPool           Boolean  @default(false) @map("has_pool")
  hasSpa            Boolean  @default(false) @map("has_spa")
  hasParking        Boolean  @default(false) @map("has_parking")
  hasEvents         Boolean  @default(false) @map("has_events")
  hasTerrace        Boolean  @default(false) @map("has_terrace")
  hasLaundry        Boolean  @default(false) @map("has_laundry")
  buildingProtected Boolean  @default(false) @map("building_protected")
  expiringSoonDays  Int      @default(30) @map("expiring_soon_days")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("compliance_property_profiles")
}

model ComplianceItem {
  id                  String    @id @default(cuid())
  propertyId          String    @map("property_id")
  requirementCode     String    @map("requirement_code")
  applies             Boolean   @default(true)
  appliesOverride     Boolean?  @map("applies_override")
  notApplicableReason String?   @map("not_applicable_reason")
  status              String    @default("PENDING")
  responsibleUserId   String?   @map("responsible_user_id")
  responsibleName     String?   @map("responsible_name")
  externalAdvisorName String?   @map("external_advisor_name")
  issueDate           DateTime? @map("issue_date")
  expiryDate          DateTime? @map("expiry_date")
  lastReviewDate      DateTime? @map("last_review_date")
  nextReviewDate      DateTime? @map("next_review_date")
  notes               String?
  correctiveAction    String?   @map("corrective_action")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([propertyId, requirementCode])
  @@index([propertyId])
  @@map("compliance_items")
}

model ComplianceDocument {
  id               String    @id @default(cuid())
  propertyId       String    @map("property_id")
  requirementCode  String?   @map("requirement_code")
  areaCode         String?   @map("area_code")
  title            String
  documentType     String?   @map("document_type")
  fileName         String    @map("file_name")
  objectKey        String?   @map("object_key")
  mimeType         String?   @map("mime_type")
  fileSize         Int       @default(0) @map("file_size")
  issueDate        DateTime? @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  issuingAuthority String?   @map("issuing_authority")
  providerName     String?   @map("provider_name")
  isCurrent        Boolean   @default(true) @map("is_current")
  uploadedByUserId String?   @map("uploaded_by_user_id")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
