/// Rate grid v2 · one row per (property, roomType, ratePlan, channel, date).
/// `ratePlanId` and `channelId` are NOT NULL: the sentinel "*" means "all plans"
/// / "base (every channel)" so the unique key has no NULLs (Postgres treats
/// NULL ≠ NULL and the v1 upserts duplicated rows on every write).
model RestrictionDay {
  id                String   @id @default(cuid())
  propertyId        String   @map("property_id")
  roomTypeId        String   @map("room_type_id")
  ratePlanId        String   @default("*") @map("rate_plan_id")
  channelId         String   @default("*") @map("channel_id")
  date              DateTime @db.Date
  minStay           Int?     @map("min_stay")
  maxStay           Int?     @map("max_stay")
  minStayThrough    Int?     @map("min_stay_through")
  closedToArrival   Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture Boolean  @default(false) @map("closed_to_departure")
  /// The rate plan is not bookable that night (plan-level).
  closed            Boolean  @default(false)
  /// The room type is pulled from sale that night (room-level).
  stopSell          Boolean  @default(false) @map("stop_sell")
  minAdvanceDays    Int?     @map("min_advance_days")
  maxAdvanceDays    Int?     @map("max_advance_days")
  restrictionSource String   @default("manual") @map("restriction_source")
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([propertyId, roomTypeId, ratePlanId, channelId, date])
  @@index([propertyId, date])
  @@map("restriction_days")
}

