// ---- Finanzas · contabilidad PGC Pymes (tanda 2026-09-15, lote schema) ----
// Contrato de datos: docs/runbooks/finanzas-contabilidad.md §«Contrato de datos».

/// Naturaleza contable PGC de una cuenta. `Account.accountType` queda como alias heredado (revenue == income).
enum AccountKind {
  asset
  liability
  equity
  income
  expense
}

/// Método de cobro canónico (Payment.methodCode). Cuenta de contrapartida: cash→570, card_terminal→5721,
/// card_online→5722, bank_transfer→572, payment_link→5722, other→572.
enum PaymentMethod {
  cash
  card_terminal
  card_online
  bank_transfer
  payment_link
  other
}

enum SupplierBillStatus {
  draft
  approved
  posted
  paid
  cancelled
}

/// Con qué se pagó un gasto menor (Expense): cash→570, card→5721 (tarjeta de empresa: 572 si es débito directo), bank→572.
enum ExpensePaidWith {
  cash
  card
  bank
}

enum FixedAssetStatus {
  active
  fully_depreciated
  disposed
}

enum DepreciationRunStatus {
  draft
  posted
  reversed
}

/// Lote de coste de personal importado (Tanda 6c): draft → posted (asientos) → reversed (reverso completo).
enum PayrollCostImportStatus {
  draft
  posted
  reversed
}

/// Lote de importación contable desde Sage 200 (Tanda 7c): draft → posted (asientos / filas de libros) → reversed (reverso completo del lote).
enum LedgerImportStatus {
  draft
  posted
  reversed
}

/// Lote de importación masiva de reservas (Tanda 7): processing (lote creado, filas en curso: «Interrumpida» si el proceso murió; deshacible) · imported (todas las filas válidas creadas) · partial (alguna fila omitida o con error en el alta) · failed (ninguna reserva creada) · undone (reservas del lote canceladas por «deshacer»).
enum ReservationImportStatus {
  /// Lote creado antes de la primera reserva; filas en curso. Si el proceso muere queda así («Interrumpida») y sigue siendo deshacible.
  processing
  /// Todas las filas de datos crearon su reserva.
  imported
  /// Se crearon reservas pero alguna fila quedó omitida o falló en el alta.
  partial
  /// Ninguna reserva creada.
  failed
  /// Deshecho: las reservas del lote sin check-in fueron canceladas.
  undone
}

enum CashClosureStatus {
  open
  closed
  approved
}

/// Libros registro de IVA (RD 1619/2012 art. 62 RIVA): emitidas, recibidas, bienes de inversión.
enum VatBook {
  emitidas
  recibidas
  bienes_inversion
}

enum VatBookSourceType {
  invoice
  rectification
  simplified
  supplier_bill
  expense
  /// Tanda 7c: fila de los libros de IVA importada desde Sage 200 (lote vat_books; sourceId <empresa>:<ejercicio>:<serie>:<factura>[:R]). rebuildVatBooks la conserva.
  sage200
}

enum VatPeriodicity {
  quarterly
  monthly
}

/// FIX-1 · F2: régimen de IVA de una fila de los libros (RD 1619/2012 / Modelo 303).
/// interior (régimen general, casillas 01-09 / 28-31) · isp (inversión del sujeto pasivo: autofactura
/// emitida 12/13 y cuota soportada 38/39) · aib (adquisición intracomunitaria: 10/11 y 36/37) ·
/// importacion (DUA, tipo F5: 32/33) · exento_no_sujeto (0 % exenta / no sujeta por localización: 120).
/// null = sin clasificar (filas anteriores a F2 y escritores nativos): el 303 las trata como interior.
enum VatBookRegime {
  interior
  isp
  aib
  importacion
  exento_no_sujeto
}

/// general · redeme (devolución mensual, periodicidad mensual obligatoria) · recargo (recargo de equivalencia).
enum VatRegime {
  general
  redeme
  recargo
}

enum FinancialStatementKind {
  balance
  pyg
  ecpn
  memoria
  usali
}

/// csv_universal SIEMPRE disponible; contaplus_diario / a3 se marcan «validar con la gestoría»; vat_books_csv = libros de IVA.
enum GestoriaExportFormat {
  csv_universal
  contaplus_diario
  a3
  vat_books_csv
}

enum HousekeepingTaskStatus {
  pending
  assigned
  in_progress
  done
  rejected
}

enum WorkOrderStatus {
  open
  assigned
  in_progress
  waiting_vendor
  resolved
  closed
}

enum ComplianceStatus {
  draft
  missing_data
  ready_to_sign
  signed
  ready_to_submit
  queued
  exported
  submitted
  accepted
  rejected
  failed
  annulled
  corrected
  expired
}

enum SubmissionStatus {
  queued
  sent
  accepted
  rejected
  failed
  annulled
  retrying
}

enum ActorType {
  user
  ai
  system
}

// ---- Finanzas · estructura societaria (Tanda 6b · L1, 2026-09-16) ----
// Grupo (Organization) → Sociedad (LegalEntity = NIF) → Centro de trabajo
// (Property.kind). Design: docs/design/FINANZAS-ESTRUCTURA-SOCIETARIA.md §5.1;
// data contract: docs/runbooks/finanzas-contabilidad.md §17.

/// Work-centre type of a Property: `hotel` runs rooms/rates/POS/tourist tax/SES;
/// `office` (head office) and `other` only carry finance rows (payroll, bills,
/// banks, assets, withholdings). listOperationalProperties() filters on it.
enum PropertyKind {
  hotel
  office
  other
}

/// Legal form of the legal entity (LSC / persona física).
enum LegalForm {
  sa
  sl
  slu
  coop
  persona_fisica
  otra
}

/// PGC template the annual accounts are produced with (LSC arts. 257-258).
enum PgcVariant {
  pymes
  general
}

/// VeriFactu chain cardinality per legal entity: one installation (chain) per
/// billing centre, or a single one for the whole NIF (Orden HAC/1177/2024 7.c).
enum VerifactuChainScope {
  per_center
  per_entity
}

enum LegalEntityStatus {
  active
  dormant
}

/// Reporting route of a VeriFactu installation.
enum VerifactuRoute {
  verifactu
  tbai
  igic
}

// ---- RBAC por departamento, nivel y ámbito (Tanda 8a · L0, 2026-09-18) ----
// Design: docs/design/RBAC-DEPARTAMENTOS.md §4.1 (levels × scope), §4.7
// (thresholds, approvals), §6.1 (data model). Same values as the `as const`
// arrays of packages/shared/src/rbac-types.ts (tests/rbac-sod-contract pins it).

/// Level of a role template (N1 operative … N7 central administration).
enum RoleLevel {
  operative
  supervisor
  hotel_director
  operations_director
  general_management
  ownership
  central_admin
}

/// Scope of a role assignment: one property, a property group (clúster), the
/// legal entity (sociedad: every work centre) or the whole organisation.
enum ScopeType {
  property
  property_group
  legal_entity
  organization
}

/// Operations with an amount / percentage threshold (role_thresholds).
enum ThresholdAction {
  folio_adjust
  refund
  discount
  invoice_cancel
  day_reopen
  rate_change
  supplier_bill
  purchase_order
  payroll
  capex
  accounting_export
}

/// Kind of maker/checker approval request.
enum ApprovalKind {
  refund
  folio_adjust
  discount
  rate_change
  supplier_bill
  purchase_order
  payroll
  capex
  invoice_cancel
  day_reopen
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

/// Tanda T9 (documentos y digitalización): tipo de documento entrante (clasificación por IA o reglas; `unknown` hasta clasificar).
enum IncomingDocumentKind {
  invoice
  delivery_note
  receipt
  letter
  administrative_notice
  contract
  e_invoice_status
  other
  unknown
}

/// Tanda T9: estado del flujo centro → oficina (docs/design/DOCUMENTOS-DIGITALIZACION.md §6.1). `rejected` es final;
/// `returned_to_centre` vuelve a `captured` con `recapture`. extractionStatus, physicalStatus y blockedAt/deletedAt son ejes ortogonales.
enum IncomingDocumentStatus {
  captured
  sent_to_office
  in_review
  approved
  posted
  archived
  returned_to_centre
  rejected
}

/// Tanda T9: vía de entrada del documento (sin escáneres en esta tanda: subida manual, móvil y correo).
enum IncomingDocumentSource {
  upload
  mobile
  email
  scanner
  e_invoice
  api
}

/// Tanda T9: dónde vive el fichero (`inline` = columna document_files.inline; `disk` = adaptador local; `s3` = contrato S3).
enum DocumentStorageKind {
  inline
  disk
  s3
}

/// Tanda T9: dónde está el papel (§6.4): at_centre → in_transit (valija) → at_office → filed; not_applicable para e-mail / e-factura / API.
enum DocumentPhysicalStatus {
  at_centre
  in_transit
  at_office
  filed
  not_applicable
}

/// Tanda T9: estado de la recepción de mercancía (albarán): received → matched (cotejo parcial) → billed (todas las líneas casadas) · disputed.
enum GoodsReceiptStatus {
  received
  matched
  billed
  disputed
}

/// Tanda T9: ciclo de una tarea con plazo derivada de un documento (§7.3).
enum DocumentActionStatus {
  open
  done
  cancelled
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  /// deprecated (Tanda 6b): the legal name lives in LegalEntity.legalName. Kept for the
  /// backfill and for tenants without a legal entity yet; Finanzas reads it ONLY through
  /// resolveLegalIdentity (apps/api/src/lib/finance-scope.ts). Contract test:
  /// tests/legal-identity-readers-contract.test.mjs.
  legalName String?  @map("legal_name")
  /// deprecated (Tanda 6b): the NIF lives in LegalEntity.taxId (same rule as legalName).
  taxId     String?  @map("tax_id")
  country   String   @default("ES")
  createdAt DateTime @default(now()) @map("created_at")
  /// Tanda 8a: incremented on every write of roles / assignments → invalidates the permission caches of live sessions.
  rbacVersion Int    @default(0) @map("rbac_version")

  @@map("organizations")
}

/// Sociedad (sujeto pasivo = NIF). Exactly ONE per organization in Tanda 6b
/// (isDefault = true; POST /legal-entities → 409 MULTI_ENTITY_NOT_ENABLED). Single
/// source of the issuer identity (invoices, XML, PDF, AEAT declarant, SEPA debtor,
/// payroll employer). Created by the backfill (apps/api/src/scripts/backfill-legal-structure.ts)
/// or by createTenant (L2). The ledger (chart, journal, VAT books, models, fiscal
/// years, annual accounts) stays keyed by organizationId and is reached through
/// resolveLedgerScope, which resolves to this row.
model LegalEntity {
  id                            String              @id @default(cuid())
  /// Immutable (trigger legal_entities_organizacion_inmutable, migration 20260916102000):
  /// a sociedad never changes organisation (R10.1); a sociedad of another grupo is a new row.
  organizationId                String              @map("organization_id")
  /// 2-6 upper-case letters/digits; unique inside the organization.
  code                          String
  legalName                     String              @map("legal_name")
  /// Normalised NIF with a valid checksum, or null while pending (the backfill leaves it
  /// null with a warning for an invalid or duplicated value). Unique when set (20260916101000).
  taxId                         String?             @unique @map("tax_id")
  legalForm                     LegalForm?          @map("legal_form")
  fiscalAddress                 String?             @map("fiscal_address")
  fiscalPostalCode              String?             @map("fiscal_postal_code")
  fiscalMunicipality            String?             @map("fiscal_municipality")
  fiscalIneCode                 String?             @map("fiscal_ine_code")
  fiscalProvince                String?             @map("fiscal_province")
  /// Domicilio social when it differs from the fiscal address.
  registeredOfficeAddress       String?             @map("registered_office_address")
  registeredOfficePostalCode    String?             @map("registered_office_postal_code")
  registeredOfficeMunicipality  String?             @map("registered_office_municipality")
  registeredOfficeProvince      String?             @map("registered_office_province")
  mercantileRegistry            String?             @map("mercantile_registry")
  cnae                          String?
  pgcVariant                    PgcVariant          @default(pymes) @map("pgc_variant")
  fiscalYearStartMonth          Int                 @default(1) @map("fiscal_year_start_month")
  /// Gran empresa / SII regime (RIVA 62.6, 71.3): governs monthly VAT, 347/390 "no se presenta"
  /// and VeriFactu exclusion (R8). PropertyComplianceSetting.siiEnabled is deprecated in its favour.
  largeCompany                  Boolean             @default(false) @map("large_company")
  siiEnabled                    Boolean             @default(false) @map("sii_enabled")
  verifactuChainScope           VerifactuChainScope @default(per_center) @map("verifactu_chain_scope")
  /// Código de cuenta de cotización principal (RD 84/1996 13.3); provincial CCCs live on the centre.
  cccPrincipal                  String?             @map("ccc_principal")
  isDefault                     Boolean             @default(true) @map("is_default")
  status                        LegalEntityStatus   @default(active)
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @default(now()) @updatedAt @map("updated_at")

  properties                    Property[]
  verifactuInstallations        VerifactuInstallation[]

  @@unique([organizationId, code])
  @@index([organizationId, isDefault])
  @@map("legal_entities")
}

/// One "facturación" (SIF installation) of a legal entity: the VeriFactu chain is
/// per pair (obligado; instalación). `numeroInstalacion` is IMMUTABLE (trigger
/// verifactu_installations_numero_inmutable, migration 20260916100000) and never
/// reused: changing scope retires the row (retiredAt) and opens a new number.
/// Replaces the global VERIFACTU_INSTALL_NUMBER (env = sandbox fallback only).
model VerifactuInstallation {
  id                String         @id @default(cuid())
  legalEntityId     String         @map("legal_entity_id")
  /// Billing centre with `per_center`; null with `per_entity` (one chain per NIF).
  propertyId        String?        @map("property_id")
  numeroInstalacion String         @map("numero_instalacion")
  route             VerifactuRoute @default(verifactu)
  /// Foral territory for TBAI (bizkaia · gipuzkoa · araba) or null.
  territory         String?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  retiredAt         DateTime?      @map("retired_at")

  legalEntity       LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  @@unique([legalEntityId, numeroInstalacion])
  @@index([propertyId, active])
  @@map("verifactu_installations")
}

model Property {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  name                  String
  /// deprecated (Tanda 6b): never the issuer's legal name (that is LegalEntity.legalName).
  /// The backfill copied it to `tradeName` when it differed from the razón social; no
  /// finance module reads it (tests/legal-identity-readers-contract.test.mjs).
  legalName             String?  @map("legal_name")
  address               String?
  municipality          String?
  province              String?
  country               String   @default("ES")
  taxRegion             String?  @map("tax_region")
  /// Tanda 3: postal code and INE municipality code (5 digits) — required by the SES.HOSPEDAJES establishment block.
  postalCode            String?  @map("postal_code")
  ineMunicipalityCode   String?  @map("ine_municipality_code")
  /// Tanda 3: reporting territory ('common' → VeriFactu; 'bizkaia' | 'gipuzkoa' | 'araba' | 'navarra' → TicketBAI/foral).
  fiscalTerritory       String?  @map("fiscal_territory")
  timezone              String   @default("Europe/Madrid")
  /// Rate grid v2 · ISO 4217 currency of every rate of the property.
  currency              String   @default("EUR")
  status                String   @default("open")
  /// Tanda L5 (lote C): fecha de la aprobación del go-live (approveGoLive). NULL = sin aprobar.
  goLiveAt              DateTime? @map("go_live_at")
  sesHospedajesEnabled  Boolean  @default(false) @map("ses_hospedajes_enabled")
  verifactuEnabled      Boolean  @default(false) @map("verifactu_enabled")
  // Invoice branding: the hotel's logo (URL or data: URI) and a free-text legal
  // disclaimer / footer block printed at the bottom of every invoice (privacy
  // notice, mercantile registry data, payment terms, etc.).
  invoiceLogoUrl        String?  @map("invoice_logo_url")
  invoiceLegalFooter    String?  @map("invoice_legal_footer")
  createdAt             DateTime @default(now()) @map("created_at")

  // Tanda 6b (L1): work centre of a legal entity. Nullable until every Property
  // writer (createTenant, provisioning — L2) sets it; the backfill fills existing rows
  // and the NOT NULL step is deferred (see migration 20260916101000 header).
  /// Sociedad the centre belongs to (same organization; invariant R10.1). Never changes once
  /// invoices or an installation exist (R10.5). Both enforced by trigger
  /// properties_sociedad_inmutable (migration 20260916102000): a NULL may still be filled.
  legalEntityId         String?  @map("legal_entity_id")
  kind                  PropertyKind @default(hotel)
  /// 2-6 upper-case code (RA, LT, OC…) used in series prefixes when the entity has several
  /// billing centres; unique inside the legal entity.
  code                  String?
  /// Nombre comercial printed in the establishment block of the invoice (never as razón social).
  tradeName             String?  @map("trade_name")
  // Census / local data (036, IAE, registro turístico, SES, TGSS, centro de trabajo):
  // stored and exported for the gestoría, never self-assessed by Anfitorio.
  cadastralReference    String?  @map("cadastral_reference")
  surfaceM2             Decimal? @db.Decimal(10, 2) @map("surface_m2")
  iaeEpigraph           String?  @map("iae_epigraph")
  bedCapacity           Int?     @map("bed_capacity")
  starRating            Int?     @map("star_rating")
  openingMonths         Int?     @map("opening_months")
  tourismRegistryNumber String?  @map("tourism_registry_number")
  sesEstablishmentCode  String?  @map("ses_establishment_code")
  /// Código de cuenta de cotización secundario (provincial) of this centre.
  socialSecurityCcc     String?  @map("social_security_ccc")
  laborCenterCode       String?  @map("labor_center_code")
  /// Tanda RRHH (2026-09-20): convenio colectivo del centro (CollectiveAgreement.id); el del contrato prevalece.
  agreementId           String?  @map("agreement_id")

  legalEntity           LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  rateChangeJournals    RateChangeJournal[]

  @@unique([legalEntityId, code])
  @@index([organizationId])
  @@index([legalEntityId, kind])
  @@map("properties")
}

model User {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  email                String    @unique
  phone                String?
  fullName             String    @map("full_name")
  status               String    @default("active")
  mfaEnabled           Boolean   @default(false) @map("mfa_enabled")
  passwordHash         String?   @map("password_hash")
  // Lockout para defensa anti-brute-force (PILOT-D1)
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until")
  lastLoginAt          DateTime? @map("last_login_at")
  passwordChangedAt    DateTime? @map("password_changed_at")
  /// Tanda 3: set on temporary/reissued passwords; the API only allows change-password until cleared.
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  createdAt            DateTime  @default(now()) @map("created_at")
  themePreference      String    @default("auto") @map("theme_preference")
  accentColor          String    @default("#007aff") @map("accent_color")
  reducedMotion        Boolean   @default(false) @map("reduced_motion")
  highContrast         Boolean   @default(false) @map("high_contrast")
  // Tanda 8a (RBAC · §5.6 PIN de supervisor): hashed PIN, lockout counters. `status` stays a
  // String: the break-glass accounts use the new value "emergency" (§4.8).
  pinHash              String?   @map("pin_hash")
  pinUpdatedAt         DateTime? @map("pin_updated_at")
  pinFailedAttempts    Int       @default(0) @map("pin_failed_attempts")
  pinLockedUntil       DateTime? @map("pin_locked_until")

  @@index([organizationId])
  @@map("users")
}

/// Tanda 3 (CFG-P1-6): real user invitations — single-use hashed token, 72 h TTL, delivery tracked in notification_deliveries.
model UserInvitation {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  organizationId  String    @map("organization_id")
  propertyId      String?   @map("property_id")
  roleId          String?   @map("role_id")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdByUserId String?   @map("created_by_user_id")
  deliveryId      String?   @map("delivery_id")
  deliveryStatus  String?   @map("delivery_status")
  createdAt       DateTime  @default(now()) @map("created_at")
  // Tanda 8a (RBAC · §5.5): invitations carry the scope of the assignment they create on
  // acceptance (scopeRef = property / group / legal entity / organisation id) and the inviter.
  scopeType       ScopeType? @map("scope_type")
  scopeRef        String?   @map("scope_ref")
  invitedByUserId String?   @map("invited_by_user_id")

  @@index([userId])
  @@index([organizationId, createdAt])
  @@map("user_invitations")
}

// PasswordResetToken — single-use token for password reset flow (PILOT-D1).
// TTL 15 min, token guardado como hash para que un dump de DB no comprometa
// los reset pendientes. Marca de uso evita replay.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Device {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  deviceName   String   @map("device_name")
  platform     String
  pushToken    String?  @map("push_token")
  trusted      Boolean  @default(false)
  registeredAt DateTime @default(now()) @map("registered_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")

  @@index([userId, trusted])
  @@map("devices")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  deviceId   String    @map("device_id")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, status])
  @@map("sessions")
}

model MfaChallenge {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  purpose         String
  status          String   @default("pending")
  deliveryChannel String   @map("delivery_channel")
  codeHash        String?  @map("code_hash")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, status, expiresAt])
  @@map("mfa_challenges")
}

/// Notificaciones in-app (Tanda L2 · L2-01): aisladas por organización. `organizationId`
/// es NOT NULL en Postgres (filas existentes rellenadas desde properties.organization_id
/// en la migración 20260918130000); el `@default("")` solo existe para que el escritor
/// previo (auth.service.ts notificationToDbRow, sin organizationId; fuera del lote) siga
/// compilando. Deuda: el lote de /notifications pasa organizationId explícito y la
/// migración siguiente retira el default y añade CHECK (organization_id <> '').
model Notification {
  id             String   @id @default(cuid())
