/// Inmovilizado: alta en 21x/20x, amortización mensual D 68x / H 28x con coeficiente máximo de tablas (art. 12 LIS).
model FixedAsset {
  id                      String    @id @default(cuid())
  propertyId              String    @map("property_id")
  assetId                 String?   @map("asset_id")
  name                    String
  acquisitionDate         DateTime? @map("acquisition_date") @db.Date
  acquisitionCost         Decimal   @default(0) @map("acquisition_cost") @db.Decimal(12, 2)
  depreciationMethod      String?   @map("depreciation_method")
  usefulLifeMonths        Int?      @map("useful_life_months")
  accumulatedDepreciation Decimal   @default(0) @map("accumulated_depreciation") @db.Decimal(12, 2)
  // Finanzas (2026-09-15): cuentas, coeficiente y ciclo de vida contable.
  /// null solo en filas heredadas (= Property.organizationId).
  organizationId          String?   @map("organization_id")
  /// mobiliario (10 %) · instalaciones (10 %) · informatica (25 %) · construcciones (3 %) · vehiculos (16 %) · intangible · otro.
  category                String?
  /// Cuenta de activo (21x material, 20x intangible).
  accountCode             String?   @map("account_code")
  /// Cuenta de amortización acumulada (28x).
  depreciationAccountCode String?   @map("depreciation_account_code")
  /// Cuenta de dotación (681 material, 680 intangible).
  expenseAccountCode      String?   @map("expense_account_code")
  /// Coeficiente anual aplicado (%), ≤ máximo de tablas art. 12 LIS para su categoría.
  coefficientPct          Decimal?  @map("coefficient_pct") @db.Decimal(5, 2)
  /// Inicio de la amortización (puesta en condiciones de funcionamiento); null = acquisitionDate.
  startDate               DateTime? @map("start_date") @db.Date
  residualValue           Decimal   @default(0) @map("residual_value") @db.Decimal(12, 2)
  status                  FixedAssetStatus @default(active)
  disposedAt              DateTime? @map("disposed_at") @db.Date
  supplierBillId          String?   @map("supplier_bill_id")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([organizationId, status])
  @@map("fixed_assets")
}

