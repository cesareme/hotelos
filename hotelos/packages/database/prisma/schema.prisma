  @@unique([channelId, roomTypeId, ratePlanId])
  @@index([propertyId, channelId, status])
  @@map("channel_product_mappings")
}

/// Rate grid v2 · outbox of ARI deliveries: one row per (channel, kind, roomType,
/// ratePlan, date). The editor reads the status per cell and channel; the drain
/// job batches queued rows per channel, calls the adapter with retries and
/// backoff, and marks the outcome. Idempotency key = sha256(channel, kind,
/// roomType, plan, date, payload) so re-sending an unchanged value is a no-op.
model ChannelDelivery {
  id             String    @id @default(cuid())
  propertyId     String    @map("property_id")
  channelId      String    @map("channel_id")
  /// rates | availability | restrictions
  kind           String
  roomTypeId     String    @map("room_type_id")
  /// "*" for availability (room-level) deliveries.
  ratePlanId     String    @default("*") @map("rate_plan_id")
  date           DateTime  @db.Date
  payloadJson    Json      @default("{}") @map("payload_json")
  payloadHash    String    @map("payload_hash")
  idempotencyKey String    @map("idempotency_key")
  /// queued | sending | sent | confirmed | rejected | timeout | superseded
  status         String    @default("queued")
  attempts       Int       @default(0)
  nextRetryAt    DateTime? @map("next_retry_at")
  lastError      String?   @map("last_error")
  externalRef    String?   @map("external_ref")
  syncJobId      String?   @map("sync_job_id")
  journalId      String?   @map("journal_id")
  sentAt         DateTime? @map("sent_at")
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([channelId, idempotencyKey])
  @@index([propertyId, channelId, status])
  @@index([channelId, roomTypeId, ratePlanId, date])
  @@index([status, nextRetryAt])
  @@map("channel_deliveries")
}

