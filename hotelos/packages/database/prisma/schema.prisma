model InvoiceSequence {
  id           String  @id @default(cuid())
  propertyId   String  @map("property_id")
  sequenceCode String  @map("sequence_code")
  /// Series prefix as printed (FAC-2026- · FAC-LT-2026-). Tanda 6b: unique per legal entity and
  /// year (case-insensitive) — guarded by assertSeriesPrefixFree (409 SERIES_PREFIX_CLASH); the
  /// unique index (legal_entity_id, upper(prefix), year) is created once the collision report is clean.
  /// Still nullable: patchBillingSettings (L2) writes null to reset a series; NOT NULL lands with L2
  /// (legacy NULLs are already filled as `<code>-<year>-` by migration 20260916101000).
  prefix       String?
  nextNumber   Int     @default(1) @map("next_number")
  padding      Int     @default(6)
  invoiceType  String  @map("invoice_type")
  active       Boolean @default(true)
  /// Tanda 3 (FISC-09): fiscal year of the series (FAC-2027-000001 starts a new row). Tanda L2 (L2-01):
  /// 0 NULL en Faranda y los tres escritores ya lo pasan; la migración 20260918130000 lo protege con la
  /// restricción CHECK `invoice_sequences_year_not_null` (Prisma no la ve). Sigue `Int?` en el cliente
  /// porque invoice.service.ts:527, backoffice.service.ts:5901 y series-prefix.service.ts:72 aún buscan
  /// filas heredadas con `year: null`; al retirarlas, `Int` + SET NOT NULL en la migración siguiente.
  year         Int?
  /// Tanda 6b (L1): issuing legal entity (backfilled from the property; NOT NULL deferred to L2 writers).
  legalEntityId String? @map("legal_entity_id")

  @@unique([propertyId, sequenceCode, year])
  @@index([propertyId, sequenceCode])
  @@index([legalEntityId, year])
  @@map("invoice_sequences")
}

