// ---- Coste de personal importado (Tanda 6c · 2026-09-16) ----
// Contrato: docs/runbooks/finanzas-contabilidad.md §18 · diseño docs/design/FINANZAS-COSTE-PERSONAL.md §2.
// Agregado centro × mes × grupo × departamento: NUNCA datos por persona (GDPR). Un lote = un fichero
// (csv | json | informe_rrhh); contabilización = un asiento por (centro, mes) con sourceType
// payroll_cost_import y sourceId <importId>:<propertyId>:<periodCode>; reverso completo del lote
// (reverseJournalEntry por asiento). Sin relaciones a properties / cost_centers (misma convención que
// PayrollPeriod); organizationId desnormalizado en líneas y referencias para filtrar sin join.

/// Lote de importación del informe de coste de personal (agregado, sin nombres).
model PayrollCostImport {
  id                      String                  @id @default(cuid())
  organizationId          String                  @map("organization_id")
  /// Sociedad empleadora (LegalEntity de la organización, vía resolveLedgerScope) si se conoce; informativo.
  legalEntityId           String?                 @map("legal_entity_id")
  /// csv · json · informe_rrhh (texto: catálogo en el runbook §18).
  source                  String
  fileName                String?                 @map("file_name")
  /// sha256 hex del contenido normalizado (filas + referencias): idempotencia (409 PAYROLL_IMPORT_DUPLICATE mientras exista un lote no revertido con el mismo hash).
  contentHash             String                  @map("content_hash")
  /// Primer y último mes del lote ("YYYY-MM", inclusivo).
  periodFrom              String                  @map("period_from")
  periodTo                String                  @map("period_to")
  status                  PayrollCostImportStatus @default(draft)
  rowCount                Int                     @default(0) @map("row_count")
  totalGross              Decimal                 @default(0) @db.Decimal(14, 2) @map("total_gross")
  totalEmployerSs         Decimal                 @default(0) @db.Decimal(14, 2) @map("total_employer_ss")
  /// Σ(gross + employerSs): lo que se contabiliza (640 + 642).
  totalCost               Decimal                 @default(0) @db.Decimal(14, 2) @map("total_cost")
  /// Σ coste_total del fichero (informativo; puede diferir de totalCost, se avisa al importar).
  reportedTotalCost       Decimal?                @db.Decimal(14, 2) @map("reported_total_cost")
  /// Media mensual de empleados del lote (referencia del informe o Σ headcount de las celdas), 2 decimales.
  headcountAverage        Decimal?                @db.Decimal(8, 2) @map("headcount_average")
  /// Mapeo aplicado al importar: { centres: {etiqueta→propertyId}, departments: {etiqueta→usaliDepartment}, groups? }.
  mappingJson             Json                    @default("{}") @map("mapping_json")
  /// Asientos de devengo (uno por centro × mes) y sus reversos.
  journalEntryIds         String[]                @default([]) @map("journal_entry_ids")
  reversalJournalEntryIds String[]                @default([]) @map("reversal_journal_entry_ids")
  notes                   String?
  createdBy               String?                 @map("created_by")
  createdAt               DateTime                @default(now()) @map("created_at")
  postedAt                DateTime?               @map("posted_at")
  reversedAt              DateTime?               @map("reversed_at")
  reversedBy              String?                 @map("reversed_by")
  reversalReason          String?                 @map("reversal_reason")

  lines                   PayrollCostLine[]
  references              PayrollCostReference[]

  @@index([organizationId, status, periodFrom, periodTo])
  @@index([organizationId, contentHash])
  @@map("payroll_cost_imports")
}

/// Fila agregada del informe: centro × mes × grupo × departamento (sin personas).
model PayrollCostLine {
  id                String   @id @default(cuid())
  importId          String   @map("import_id")
  /// Desnormalizado del lote (sin FK): filtros de solape y del informe por organización sin join.
  organizationId    String   @map("organization_id")
  /// Centro de trabajo del ERP (Property de la organización) al que se asignó la etiqueta original.
  propertyId        String   @map("property_id")
  /// Etiqueta de centro tal como viene en el informe ("OFICINA MADRID", "REG. CORUÑA"…): varias etiquetas pueden ir al mismo centro.
  workCenterLabel   String   @map("work_center_label")
  /// operaciones · extras · estructura · mantenimiento_obra · familia (texto; catálogo en el runbook §18).
  costGroup         String   @map("cost_group")
  /// Departamento tal como viene en el informe ("3 RECEPCIO", "6 PISOS"…).
  departmentLabel   String   @map("department_label")
  /// Departamento USALI resuelto que admite la línea labor (rooms · fnb · other_operated · admin_general · it · sales_marketing · pom).
  usaliDepartment   String   @map("usali_department")
  /// CostCenter (propertyId, code = USALI en mayúsculas, type "usali") al que se imputan las líneas 640/642; se rellena al contabilizar.
  costCenterId      String?  @map("cost_center_id")
  /// "YYYY-MM".
  periodCode        String   @map("period_code")
  gross             Decimal  @db.Decimal(14, 2)
  employerSs        Decimal  @db.Decimal(14, 2) @map("employer_ss")
  /// = gross + employerSs (lo contabilizado).
  totalCost         Decimal  @db.Decimal(14, 2) @map("total_cost")
  /// coste_total del fichero (informativo; null si no viene).
  reportedTotalCost Decimal? @db.Decimal(14, 2) @map("reported_total_cost")
  /// Empleados (o FTE) de la celda en el mes; decimal para admitir jornadas parciales.
  headcount         Decimal  @default(0) @db.Decimal(8, 2)

  import            PayrollCostImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, workCenterLabel, periodCode, costGroup, departmentLabel])
  @@index([importId, propertyId, periodCode])
  @@index([propertyId, periodCode])
  @@index([organizationId, periodCode])
  @@map("payroll_cost_lines")
}

/// Referencia del informe por centro × mes (empleados, inventario de habitaciones, ventas sin IVA) para los ratios.
model PayrollCostReference {
  id                     String   @id @default(cuid())
  importId               String   @map("import_id")
  /// Desnormalizado del lote (sin FK): headcount USALI e informe por organización sin join.
  organizationId         String   @map("organization_id")
  propertyId             String   @map("property_id")
  workCenterLabel        String?  @map("work_center_label")
  periodCode             String   @map("period_code")
  employeesReported      Decimal? @db.Decimal(8, 2) @map("employees_reported")
  /// Inventario de habitaciones del informe (no habitaciones-noche).
  roomsAvailableReported Int?     @map("rooms_available_reported")
  netSalesReported       Decimal? @db.Decimal(14, 2) @map("net_sales_reported")

  import                 PayrollCostImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, propertyId, periodCode])
  @@index([propertyId, periodCode])
  @@index([organizationId, periodCode])
  @@map("payroll_cost_references")
}

// ---- Importación masiva de reservas (Tanda 7 · 2026-09-16) ----
// Contrato: docs/runbooks/reservas-importacion.md · diseño docs/design/RESERVAS-IMPORTACION-MASIVA.md.
// Un lote = un fichero (csv | xlsx) importado en UNA propiedad; las reservas se crean una a una con
// createReservation (bookingSource "import:<importId>") y se deshacen con transitionReservation
// (cancelled, motivo «importación deshecha») sobre las que sigan sin check-in. GDPR: el fichero NO se
// guarda; la fila del lote registra SOLO nº de fila, referencia externa, fechas y tipo resueltos,
// código de reserva creado o código de error (nunca nombre, e-mail, teléfono ni documento del huésped;
// los mensajes de error no deben citar valores personales). Sin FK a properties / reservations (misma
// convención que PayrollCostLine); organizationId y propertyId desnormalizados para filtrar sin join.

/// Lote de importación masiva de reservas (un fichero → N reservas en una propiedad).
model ReservationImport {
  id               String                  @id @default(cuid())
  organizationId   String                  @map("organization_id")
  propertyId       String                  @map("property_id")
  /// csv · xlsx (texto; catálogo en el runbook).
  format           String
  fileName         String?                 @map("file_name")
  /// sha256 hex de las filas normalizadas tras el mapeo: idempotencia (409 RESERVATION_IMPORT_DUPLICATE mientras exista un lote no deshecho con el mismo hash en la propiedad, salvo `force`).
  contentHash      String                  @map("content_hash")
  /// processing (creado antes de la primera reserva) → imported | partial | failed → undone.
  status           ReservationImportStatus @default(processing)
  /// Filas de datos del fichero (sin cabecera).
  rowCount         Int                     @default(0) @map("row_count")
  createdCount     Int                     @default(0) @map("created_count")
  /// Filas omitidas: inválidas con `omitirInvalidas`, referencia externa ya existente, duplicadas en el fichero.
  skippedCount     Int                     @default(0) @map("skipped_count")
  /// Filas que fallaron en el alta (p. ej. disponibilidad perdida entre la previsualización y el commit).
  errorCount       Int                     @default(0) @map("error_count")
  warningCount     Int                     @default(0) @map("warning_count")
  /// Mapeo aplicado: { "<cabecera del fichero>": "<campo canónico>" }.
  mappingJson      Json                    @default("{}") @map("mapping_json")
  /// Opciones del commit: { omitirInvalidas, permitirOverbooking, historico, force, separador, codificación }.
  optionsJson      Json                    @default("{}") @map("options_json")
  /// Primera y última llegada de las reservas creadas (informativo para el listado).
  arrivalFrom      DateTime?               @map("arrival_from") @db.Date
  arrivalTo        DateTime?               @map("arrival_to") @db.Date
  /// Σ totalAmount de las reservas creadas (informativo).
  totalAmount      Decimal                 @default(0) @db.Decimal(14, 2) @map("total_amount")
  currency         String                  @default("EUR")
  createdBy        String?                 @map("created_by")
  createdAt        DateTime                @default(now()) @map("created_at")
  undoneAt         DateTime?               @map("undone_at")
  undoneBy         String?                 @map("undone_by")
  undoReason       String?                 @map("undo_reason")
  /// Reservas canceladas al deshacer y reservas conservadas (ya con check-in / check-out).
  undoneCount      Int                     @default(0) @map("undone_count")
  undoKeptCount    Int                     @default(0) @map("undo_kept_count")

  rows             ReservationImportRow[]
  /// OPERA Cloud · modo sombra (Tanda 7b · L0): runs que produjeron este lote (feeds de reservas en modo sync).
  shadowRuns       PmsShadowRun[]

  @@index([propertyId, status, createdAt])
  @@index([propertyId, contentHash])
  @@index([organizationId, createdAt])
  @@map("reservation_imports")
}

/// Resultado por fila del fichero (sin datos personales del huésped).
model ReservationImportRow {
  id                String    @id @default(cuid())
  importId          String    @map("import_id")
  /// Desnormalizados del lote (sin FK): búsqueda por referencia externa y por reserva sin join.
  organizationId    String    @map("organization_id")
  propertyId        String    @map("property_id")
  /// Nº de fila de datos en el fichero (1 = primera fila tras la cabecera).
  rowNumber         Int       @map("row_number")
  /// created · skipped · error (texto; catálogo en el runbook).
  outcome           String
  /// Fecha/tipo/tarifa resueltos (informativo, sin PII). Null cuando la fila no llegó a normalizarse.
  externalReference String?   @map("external_reference")
  arrivalDate       DateTime? @map("arrival_date") @db.Date
  departureDate     DateTime? @map("departure_date") @db.Date
  roomTypeCode      String?   @map("room_type_code")
  ratePlanCode      String?   @map("rate_plan_code")
  roomsCount        Int       @default(1) @map("rooms_count")
  /// Reserva creada (una fila crea como máximo una reserva; una reserva procede como máximo de una fila).
  reservationId     String?   @unique @map("reservation_id")
  reservationCode   String?   @map("reservation_code")
  /// Código de error o de omisión (RESERVATION_IMPORT_ROW_*) y mensaje en español SIN valores personales.
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message")
  /// Avisos de la fila (códigos + mensajes sin PII), [] si ninguno.
  warningsJson      Json      @default("[]") @map("warnings_json")
  /// Tras deshacer: cancelled · kept (ya con check-in / check-out) · skipped (ya estaba cancelada / no-show) · null (lote no deshecho o fila sin reserva).
  undoOutcome       String?   @map("undo_outcome")

  import            ReservationImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, outcome])
  @@index([propertyId, externalReference])
  @@map("reservation_import_rows")
}

// ---- Multi-currency (Sprint 24) ----

model ExchangeRate {
  id              String   @id @default(cuid())
  baseCurrency    String   @map("base_currency")
  quoteCurrency   String   @map("quote_currency")
  rate            Decimal  @db.Decimal(14, 8)
