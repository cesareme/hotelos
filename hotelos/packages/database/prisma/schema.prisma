model Stay {
  id            String    @id @default(cuid())
  reservationId String    @map("reservation_id")
  roomId        String    @map("room_id")
  checkinAt     DateTime? @map("checkin_at")
  checkoutAt    DateTime? @map("checkout_at")
  status        String

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room          Room        @relation(fields: [roomId], references: [id])

  @@index([reservationId])
  @@map("stays")
}

model Folio {
  id            String      @id @default(cuid())
  reservationId String      @map("reservation_id")
  guestId       String?     @map("guest_id")
  status        FolioStatus @default(open)
  currency      String      @default("EUR")
  // Label distinguishes one folio from another on the same reservation. The
  // first folio is "guest" by convention; adding a "company" folio lets the
  // routing engine split charges between payers. Free-form so chains can use
  // their own labels (e.g. "F&B", "Travel agent").
  label         String      @default("guest")
  isPrimary     Boolean     @default(true) @map("is_primary")
  deletedAt     DateTime?   @map("deleted_at")

  // Relations (added in 2026 audit P1-3 to enable typed `include` and reduce
  // N+1 queries in folio routing / dashboards).
  reservation   Reservation @relation("ReservationFolios", fields: [reservationId], references: [id], onDelete: Cascade)
  lines         FolioLine[]
  payments      Payment[]
  invoices      Invoice[]   @relation("FolioInvoices")

  @@index([reservationId])
  // Hot-fix perf: filter the open vs closed folios on a reservation
  // (folio routing & balance views).
  @@index([reservationId, status])
  @@index([deletedAt])
  @@map("folios")
}

// FolioRoutingRule — when a new FolioLine of a given type is posted on a
// reservation's PRIMARY folio, automatically reroute it to a specific
// secondary folio. Standard PMS pattern: "Room goes to guest folio; F&B and
// minibar go to the company folio". Rules are evaluated in priority order.
//   sourceType: free text matching FolioLine.type (e.g. "room", "tax",
//               "breakfast", "minibar", "adjustment") or "*" for all.
//   targetFolioId: the secondary folio that should receive the line.
model FolioRoutingRule {
  id            String   @id @default(cuid())
  reservationId String   @map("reservation_id")
  sourceType    String   @map("source_type")
  targetFolioId String   @map("target_folio_id")
  priority      Int      @default(0)
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([reservationId, active, priority])
  @@map("folio_routing_rules")
}

model FolioLine {
  id          String   @id @default(cuid())
  folioId     String   @map("folio_id")
  type        String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxCode     String?  @map("tax_code")
  /// Tanda 3: optional fiscal-category override (validated against the catalogue); taxCode is legacy.
  taxCategory String?  @map("tax_category")
  total       Decimal  @db.Decimal(12, 2)
  postedAt    DateTime @default(now()) @map("posted_at")
  postedBy    String?  @map("posted_by")
  deletedAt   DateTime? @map("deleted_at")

  folio       Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@index([folioId, type])
  @@index([deletedAt])
  @@map("folio_lines")
}

model Payment {
  id           String        @id @default(cuid())
  propertyId   String        @map("property_id")
  folioId      String        @map("folio_id")
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("EUR")
  method       String
  pspReference String?       @map("psp_reference")
  // Deterministic HMAC of pspReference (Tanda 2 · PSP-IDEMPOTENCY-ENCRYPTED):
  // pspReference is AES-GCM ciphertext with a random IV, so equality lookups
  // must go through this sibling column. Filled by the Prisma encryption
  // extension (LOOKUP_HASH_FIELDS.Payment); legacy rows need
  // `pnpm --filter @hotelos/api backfill:payment-hash --apply`.
  pspReferenceLookupHash String? @map("psp_reference_lookup_hash")
  invoiceId    String?       @map("invoice_id")
  status       PaymentStatus @default(pending)
  createdAt    DateTime      @default(now()) @map("created_at")
  deletedAt    DateTime?     @map("deleted_at")
  // Finanzas (2026-09-15): idempotencia, método canónico, reversos y enlace contable.
  /// Clave de idempotencia del cliente, única por folio: un reintento con la misma clave devuelve el mismo cobro.
  clientRequestId String?       @map("client_request_id")
  /// Método canónico (enum). null = fila heredada: el lector cae a `method` (cash|card|bank_transfer|payment_link|ota_virtual_card).
  methodCode      PaymentMethod? @map("method_code")
  /// Cobro que este registro deshace (devolución / anulación): importe positivo, asiento inverso.
  reversalOfId    String?       @map("reversal_of_id")
  journalEntryId  String?       @map("journal_entry_id")
  /// Tanda 8a (SoD dinámica): who captured the payment (cashier ≠ refund approver).
  capturedByUserId String?      @map("captured_by_user_id")

  folio        Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation("InvoicePayments", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([folioId, clientRequestId])
  @@index([propertyId, folioId])
  @@index([invoiceId])
  // markInvoicePaid idempotency lookup by (invoiceId, pspReference) → hash.
  @@index([invoiceId, pspReferenceLookupHash])
  // Hot-fix perf: per-folio payment timeline (folio.service.getFolioBalance
  // sorts payments by createdAt within a folio).
  @@index([folioId, createdAt])
  // Hot-fix perf: PSP reference lookup (webhook reconciliation, refund tools).
  @@index([pspReference])
  @@index([deletedAt])
  @@index([reversalOfId])
  // Cash closure: cobros del día por propiedad y método.
  @@index([propertyId, methodCode, createdAt])
  @@map("payments")
}

model Invoice {
  id                  String        @id @default(cuid())
  propertyId          String        @map("property_id")
  invoiceNumber       String?       @map("invoice_number")
  invoiceType         String        @map("invoice_type")
  customerType        String        @map("customer_type")
  customerTaxId       String?       @map("customer_tax_id")
  /// Tanda 3 (cierre): recipient legal name for F1 invoices (VeriFactu Destinatarios/NombreRazon); snapshot at creation.
  customerName        String?       @map("customer_name")
  status              InvoiceStatus @default(draft)
  issuedAt            DateTime?     @map("issued_at")
  total               Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  currencyCode        String        @default("EUR") @map("currency_code")
  fxRate              Decimal?      @db.Decimal(14, 8) @map("fx_rate")
  baseTotal           Decimal?      @db.Decimal(12, 2) @map("base_total")
  rectifyingForId     String?       @map("rectifying_for_id")
  rectifyingReasonCode String?      @map("rectifying_reason_code")
  cancelledAt         DateTime?     @map("cancelled_at")
  verifactuHash       String?       @map("verifactu_hash")
  previousInvoiceHash String?       @map("previous_invoice_hash")
  qrPayload           String?       @map("qr_payload")
  /// Tanda 3: grouped tax breakdown persisted at issue time (same numbers in XML, PDF and UI).
  taxBreakdownJson    Json?         @map("tax_breakdown_json")
  /// Tanda 3: VeriFactu TipoRectificativa ('I' diferencias · 'S' sustitución) for rectifying invoices.
  rectificationType   String?       @map("rectification_type")
  /// Tanda 3: chained hash of the RegistroAnulacion sent to AEAT when the invoice was cancelled.
  cancellationHash    String?       @map("cancellation_hash")
  /// Tanda 3: non-blocking fiscal warnings computed at creation/issue (e.g. lines without configured tax).
  warningsJson        Json?         @map("warnings_json")
  // Tanda 2 · FISC-03/FISC-04/QC-03: issuer snapshot, source folio and payment state.
  // db push only (no migration): must enter the Tanda 4 squash baseline.
  issuerTaxId         String?       @map("issuer_tax_id")
  issuerLegalName     String?       @map("issuer_legal_name")
  issuerTaxIdPlaceholder Boolean    @default(false) @map("issuer_tax_id_placeholder")
  folioId             String?       @map("folio_id")
  reservationId       String?       @map("reservation_id")
  paidAt              DateTime?     @map("paid_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  deletedAt           DateTime?     @map("deleted_at")
  // Finanzas (2026-09-15): congelación al emitir, serie y factura simplificada.
  /// Líneas, totales, desglose de IVA e ids de FolioLine congelados al emitir ({ lines, totals, taxBreakdown, folioLineIds }); inmutable después.
  snapshotJson        Json?         @map("snapshot_json")
  /// Serie (InvoiceSequence.sequenceCode) con la que se numeró: FAC (F1/F2), FS (simplificada), R (rectificativa)…
  seriesCode          String?       @map("series_code")
  /// Factura simplificada (art. 4 RD 1619/2012): serie propia, sin NIF de cliente hasta 400 € (TPV al contado).
  simplified          Boolean       @default(false)
  /// false solo en simplificadas dentro de límite: el emisor no exige identificar al cliente.
  customerRequired    Boolean       @default(true) @map("customer_required")
  // Tanda 6b (L1): issuing legal entity and VeriFactu installation of the record. Backfilled;
  // NOT NULL and the unique (legal_entity_id, invoice_number) WHERE deleted_at IS NULL AND
  // status <> 'draft' are deferred until the duplicate report is clean (org_123 demo reuses
  // FAC-2026-000001 in two properties). issuerTaxId / issuerLegalName of an issued invoice are
  // immutable by trigger invoices_issuer_inmutable (migration 20260916100000).
  legalEntityId       String?       @map("legal_entity_id")
  installationId      String?       @map("installation_id")
  // Tanda 8a (SoD dinámica, RD 1007/2023 art. 11): issuer ≠ canceller.
  issuedByUserId      String?       @map("issued_by_user_id")
  cancelledByUserId   String?       @map("cancelled_by_user_id")

  folio               Folio?        @relation("FolioInvoices", fields: [folioId], references: [id], onDelete: SetNull)
  payments            Payment[]     @relation("InvoicePayments")

  @@unique([propertyId, invoiceNumber])
  @@index([legalEntityId, invoiceNumber])
  @@index([installationId])
  @@index([propertyId, status])
  @@index([propertyId, issuedAt])
  @@index([propertyId, createdAt])
  @@index([folioId])
  @@index([reservationId])
  @@index([rectifyingForId])
  @@index([deletedAt])
  @@index([propertyId, seriesCode, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  taxCode     String  @map("tax_code")
  taxRate     Decimal @map("tax_rate") @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)
  /// Tanda 3: fiscal category, VeriFactu calificación (S1/N1) and figure (IVA/IGIC/IPSI) resolved at creation.
  taxCategory     String? @map("tax_category")
  taxCalificacion String? @map("tax_calificacion")
  taxFigure       String? @map("tax_figure")

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// Plan de cuentas por organización (plantilla «PGC Pymes hotelero»: apps/api/src/modules/accounting/chart-of-accounts.service.ts).
model Account {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  /// Código PGC: grupo (1 dígito), subgrupo (2), cuenta (3), subcuenta ("4300", "705.1", "477.21").
  code           String
  name           String
  /// Alias heredado de `kind` para los lectores antiguos (balance/PyG/cash-flow): asset|liability|equity|revenue|expense.
  accountType    String  @map("account_type")
  parentId       String? @map("parent_id")
  // Finanzas (2026-09-15): metadatos PGC + mapeo USALI por defecto.
  kind           AccountKind
  /// Grupo PGC 1-7 (Pymes); 8-9 reservados al PGC general.
  group          Int     @map("pgc_group")
  /// 1 grupo · 2 subgrupo · 3 cuenta · 4 subcuenta.
  level          Int
  /// false en grupos y subgrupos (cabeceras): no admiten apuntes.
  isPostable     Boolean @default(true) @map("is_postable")
  /// Mapeo USALI por defecto (departamento · línea) de la plantilla; UsaliMapping lo sobreescribe por organización. null en cuentas de balance.
  usaliDepartment String? @map("usali_department")
  usaliLine      String? @map("usali_line")

  @@unique([organizationId, code])
  @@index([organizationId, kind])
  @@index([organizationId, parentId])
  @@map("accounts")
}

/// Asiento del libro diario. `sourceType` (String, contrato en docs/runbooks/finanzas-contabilidad.md): folio_line · payment ·
/// payment_refund · invoice · invoice_rectification · invoice_cancellation · pos_ticket · supplier_bill · supplier_bill_payment ·
/// expense · payroll_slip · payroll_payment · payroll_cost_import · sage200_journal · sage200_balance (Tanda 7c: diario y saldos
/// importados de Sage 200) · commission · depreciation · vat_settlement · cash_closure ·
/// card_settlement · tourist_tax · manual · regularization · closing · opening · reversal. (Sigue siendo texto: los escritores heredados lo tipan como string.)
model JournalEntry {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  propertyId     String?       @map("property_id")
  sourceType     String        @map("source_type")
  sourceId       String?       @map("source_id")
  status         JournalStatus @default(draft)
  postedAt       DateTime?     @map("posted_at")
  createdBy      String?       @map("created_by")
  currencyCode   String        @default("EUR") @map("currency_code")
  fxRate         Decimal?      @db.Decimal(14, 8) @map("fx_rate")
  fiscalYearId   String?       @map("fiscal_year_id")
  entryKind      String        @default("normal") @map("entry_kind")
  // Finanzas (2026-09-15): fecha contable, numeración por ejercicio, concepto y reversos.
  /// Fecha contable (devengo): ordena el diario y fija ejercicio/periodo. `postedAt` es el instante técnico de la proyección.
  entryDate      DateTime      @default(now()) @map("entry_date") @db.Date
  /// Número de asiento secuencial por (organización, ejercicio). null = pendiente de numerar (solo escritores heredados; el lote asientos numera al contabilizar).
  entryNumber    Int?          @map("entry_number")
  /// Ejercicio al que pertenece entryNumber: FiscalYear.code si existe, si no el año natural de entryDate ("2026").
  fiscalYearCode String?       @map("fiscal_year_code")
  /// Concepto del asiento (español, para el diario y la exportación a gestoría).
  description    String?
  /// Documento de referencia (número de factura, nómina, extracto…).
  reference      String?
  /// Asiento que este asiento anula (inverso total). Reabrir un ejercicio genera asientos de anulación: nunca se borra.
  reversalOfId   String?       @map("reversal_of_id")
  reversedById   String?       @map("reversed_by_id")

  @@unique([organizationId, fiscalYearCode, entryNumber])
  @@index([organizationId, propertyId])
  @@index([fiscalYearId, entryKind])
  @@index([organizationId, entryDate])
  @@index([organizationId, sourceType, sourceId])
  @@index([reversalOfId])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)
  currency       String  @default("EUR")
  description    String?
  // Finanzas (2026-09-15): código desnormalizado, centro de coste y datos de IVA de la línea.
  /// = Account.code de accountId (desnormalizado para diario/exportación). null solo en filas de escritores heredados: el lector cae a accountId.
  accountCode    String?  @map("account_code")
  costCenterId   String?  @map("cost_center_id")
  /// Tipo de IVA de la línea ("21", "10", "4", "0") cuando es cuota (472/477) o base; alimenta libros y Modelo 303.
  taxRateCode    String?  @map("tax_rate_code")
  /// Base imponible asociada a una línea de cuota (472/477), para el 303 sin reconstruir desde la cuota.
  taxBase        Decimal? @map("tax_base") @db.Decimal(12, 2)

  @@index([journalEntryId])
  @@index([accountCode])
  @@index([costCenterId])
  @@map("journal_lines")
}

/// Mapeo cuenta PGC → línea USALI por organización (sobreescribe Account.usaliDepartment/usaliLine).
/// El resolutor elige la coincidencia activa de mayor prioridad y, a igualdad, el prefijo más largo; sin coincidencia cae al valor por defecto de la cuenta.
model UsaliMapping {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  /// Prefijo de código PGC ("705.1" exacto o "62" para todo el subgrupo).
  accountPrefix   String   @map("account_prefix")
  /// rooms · fnb · other_operated · misc_income · admin_general · it · sales_marketing · pom · utilities · management_fees · non_operating · below_ebitda
  usaliDepartment String   @map("usali_department")
  /// revenue · cost_of_sales · labor · other_expense · management_fee · rent · property_taxes · insurance · other · interest · depreciation_amortization · income_tax
  usaliLine       String   @map("usali_line")
  priority        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, accountPrefix])
  @@index([organizationId, active, priority])
  @@map("usali_mappings")
}

/// Configuración de IVA por organización (una fila por organización).
model VatSettings {
  id             String         @id @default(cuid())
  organizationId String         @unique @map("organization_id")
  /// quarterly (régimen general, Modelo 303 trimestral) · monthly (REDEME / gran empresa).
  periodicity    VatPeriodicity @default(quarterly)
  regime         VatRegime      @default(general)
  /// Prorrata general (%) si la organización tiene actividades exentas; null = deducción íntegra.
  prorrataPct    Decimal?       @map("prorrata_pct") @db.Decimal(5, 2)
  /// Figura principal: IVA | IGIC | IPSI.
  taxFigure      String         @default("IVA") @map("tax_figure")
  /// FIX-1 · F3 (B-2): saldo inicial a compensar (casilla 110) arrastrado de periodos anteriores a la primera liquidación de ehotelOS; ≥ 0.
  openingCompensation       Decimal @default(0) @map("opening_compensation") @db.Decimal(12, 2)
  /// Código del periodo (2025-Q1 · 2025-01) desde el que aplica el saldo inicial; null = no aplica.
  openingCompensationPeriod String? @map("opening_compensation_period")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("vat_settings")
}

/// Libros registro de IVA (RD 1619/2012): una fila por documento y tipo impositivo. Fuente única del Modelo 303/390/347.
model VatBookEntry {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  propertyId       String?           @map("property_id")
  book             VatBook
  /// Fecha de expedición (emitidas) o de recepción/devengo (recibidas).
  date             DateTime          @db.Date
  series           String?
  number           String?
  counterpartyNif  String?           @map("counterparty_nif")
  counterpartyName String?           @map("counterparty_name")
  base             Decimal           @db.Decimal(12, 2)
  /// Tipo impositivo en % (21, 10, 4, 0 exenta/no sujeta; IGIC 7/3; IPSI 4/2).
  rate             Decimal           @db.Decimal(5, 2)
  quota            Decimal           @db.Decimal(12, 2)
  total            Decimal           @db.Decimal(12, 2)
  /// Retención IRPF practicada (recibidas de profesionales / alquileres); 0 si no aplica.
  retention        Decimal           @default(0) @db.Decimal(12, 2)
  taxFigure        String            @default("IVA") @map("tax_figure")
  surchargeRate    Decimal?          @map("surcharge_rate") @db.Decimal(5, 2)
  surchargeQuota   Decimal?          @map("surcharge_quota") @db.Decimal(12, 2)
  sourceType       VatBookSourceType @map("source_type")
  sourceId         String            @map("source_id")
  /// Periodo de liquidación: "2026-Q3" (trimestral) o "2026-09" (mensual), calculado con VatSettings al registrar.
  period           String
  /// false si la cuota soportada no es deducible (ticket sin NIF, prorrata 0…): la cuota va a gasto.
  deductible       Boolean           @default(true)
  /// FIX-1 · F2: régimen de la operación (interior · isp · aib · importacion · exento_no_sujeto); null = sin clasificar.
  /// Lo fija el importador de Sage (clave de operación / calificación / tipo F5) o POST /fiscal/vat-books/reclassify.
  regime           VatBookRegime?    @map("regime")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@unique([organizationId, book, sourceType, sourceId, rate])
  @@index([organizationId, book, period])
  @@index([organizationId, book, date])
  @@index([organizationId, counterpartyNif, period])
  @@index([organizationId, book, regime])
  @@map("vat_book_entries")
}

/// Factura recibida de proveedor (contabilizada línea a línea: D 6xx / D 472.tipo / H 400|410 [/ H 4751 retención]).
model SupplierBill {
  id                   String    @id @default(cuid())
  propertyId           String    @map("property_id")
  /// null solo en filas heredadas; el lote proveedores lo rellena siempre (= Property.organizationId).
  organizationId       String?   @map("organization_id")
  supplierId           String?   @map("supplier_id")
  supplierName         String?   @map("supplier_name")
  supplierTaxId        String?   @map("supplier_tax_id")
  invoiceNumber        String?   @map("invoice_number")
  issueDate            DateTime? @map("issue_date") @db.Date
  dueDate              DateTime? @map("due_date") @db.Date
  paymentDate          DateTime? @map("payment_date") @db.Date
  /// Suma de bases de las líneas (redondeo por línea, cuadre al céntimo con total = baseTotal + taxTotal − retentionAmount).
  baseTotal            Decimal   @default(0) @map("base_total") @db.Decimal(12, 2)
  total                Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  retentionRate        Decimal?  @db.Decimal(5, 2) @map("retention_rate")
  retentionAmount      Decimal?  @db.Decimal(12, 2) @map("retention_amount")
  rowCode              String?   @map("row_code")
  suggestedAccountCode String?   @map("suggested_account_code")
  roomId               String?   @map("room_id")
  status               SupplierBillStatus @default(draft)
  /// Adjunto (PDF/imagen de la factura) en el almacén de objetos.
  documentObjectKey    String?   @map("document_object_key")
  journalEntryId       String?   @map("journal_entry_id")
  /// Asiento del pago (D 400|410 / H 572|570).
  paidJournalEntryId   String?   @map("paid_journal_entry_id")
  postedAt             DateTime? @map("posted_at")
  approvedAt           DateTime? @map("approved_at")
  approvedBy           String?   @map("approved_by")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  /// Tanda 8a (SoD dinámica): who registered the bill (registrar ≠ approver ≠ payer).
  createdByUserId      String?   @map("created_by_user_id")
  /// Tanda T9 (documentos): fecha de recepción de la factura (captura por defecto); el libro de recibidas usa receptionDate ?? issueDate.
  receptionDate        DateTime? @map("reception_date") @db.Date
  /// Tanda T9: documento entrante del que nace la factura (incoming_documents.id, sin FK: el documento puede purgarse por retención).
  incomingDocumentId   String?   @map("incoming_document_id")
  /// Tanda T9: manual · digitized · e_invoice (String con catálogo en payables-types.ts, mismo criterio que JournalEntry.sourceType).
  source               String    @default("manual")
  /// Tanda T9: resultado del cotejo con albaranes: none · partial · full · variance (String, catálogo en payables-types.ts).
  matchStatus          String    @default("none") @map("match_status")

  lines                SupplierBillLine[]

  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([propertyId, status])
  @@index([supplierId, issueDate])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([incomingDocumentId])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id                 String   @id @default(cuid())
  supplierBillId     String   @map("supplier_bill_id")
  lineNo             Int      @default(1) @map("line_no")
  description        String
  /// Cuenta de gasto/inversión (6xx o 21x para bienes de inversión).
  expenseAccountCode String   @map("expense_account_code")
  base               Decimal  @db.Decimal(12, 2)
  taxRate            Decimal  @map("tax_rate") @db.Decimal(5, 2)
  quota              Decimal  @db.Decimal(12, 2)
  retention          Decimal  @default(0) @db.Decimal(12, 2)
  costCenterId       String?  @map("cost_center_id")
  /// true → libro de bienes de inversión y alta en FixedAsset (fixedAssetId).
  investmentGood     Boolean  @default(false) @map("investment_good")
  fixedAssetId       String?  @map("fixed_asset_id")
  /// Tanda T9 (documentos): cantidad facturada (cotejo con albaranes); null en facturas sin detalle de unidades.
  quantity           Decimal? @db.Decimal(12, 3)
  /// Tanda T9: precio unitario sin IVA.
  unitPrice          Decimal? @map("unit_price") @db.Decimal(12, 4)
  /// Tanda T9: nº de albarán citado en la línea de la factura (cotejo por proveedor + albarán).
  deliveryNoteRef    String?  @map("delivery_note_ref")

  supplierBill       SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  /// Tanda T9: cotejos con líneas de albarán (bill_line_matches).
  matches            BillLineMatch[]

  @@index([supplierBillId])
  @@map("supplier_bill_lines")
}

// ============================================================================
// Tanda T9 · Documentos y digitalización con IA (docs/design/DOCUMENTOS-DIGITALIZACION.md §8)
// ============================================================================

/// Documento entrante (factura, albarán, ticket, carta, notificación, contrato…) capturado en un centro y revisado por la oficina.
/// `IncomingDocument` y no `Document`: no confundir con DocumentTemplate (plantillas de texto) ni ComplianceDocument (vault de fechas).
/// Ejes ortogonales al `status` (§6.1): `extractionStatus` (pending → done | failed | skipped), `physicalStatus` (§6.4) y las banderas
/// `blockedAt` / `deletedAt` (§7.5). Ids de proveedor, factura, gasto, recepción, revisión y huésped sin FK (el documento puede purgarse por retención).
model IncomingDocument {
  id                   String                 @id @default(cuid())
  organizationId       String                 @map("organization_id")
  legalEntityId        String?                @map("legal_entity_id")
  /// Centro receptor (Property.id); el asiento y la factura heredan este centro, nunca la oficina.
  propertyId           String                 @map("property_id")
  /// DOC-<Property.code>-<AAAA>-<nnnnnn>; la secuencia por centro y año vive en registryYear/registrySeq (patrón JournalEntry.fiscalYearCode/entryNumber).
  registryNumber       String                 @map("registry_number")
  registryYear         Int                    @map("registry_year")
  registrySeq          Int                    @map("registry_seq")
  kind                 IncomingDocumentKind   @default(unknown)
  /// Confianza de la clasificación (0–1); null si se clasificó a mano.
  kindConfidence       Decimal?               @map("kind_confidence") @db.Decimal(5, 4)
  /// ai · text_rules · e_invoice · manual · email.
  classificationSource String?                @map("classification_source")
  status               IncomingDocumentStatus @default(captured)
  physicalStatus       DocumentPhysicalStatus @default(at_centre) @map("physical_status")
  source               IncomingDocumentSource @default(upload)
  /// pdf · jpeg · png · heic · xml (Facturae) · eml.
  originalFormat       String?                @map("original_format")
  title                String?
  /// SHA-256 (hex) del fichero original: duplicado por organización → 409 salvo allowDuplicate.
  sha256               String
  sizeBytes            Int                    @map("size_bytes")
  pageCount            Int                    @default(0) @map("page_count")
  supplierId           String?                @map("supplier_id")
  supplierTaxId        String?                @map("supplier_tax_id")
  documentNumber       String?                @map("document_number")
  documentDate         DateTime?              @map("document_date") @db.Date
  totalAmount          Decimal?               @map("total_amount") @db.Decimal(12, 2)
  currency             String                 @default("EUR")
  /// pending · done · failed · skipped (String: fase de la extracción, independiente del status).
  extractionStatus     String                 @default("pending") @map("extraction_status")
  /// create_supplier_bill · create_expense · create_goods_receipt · create_task · archive.
  proposedAction       String?                @map("proposed_action")
  /// Propuesta (factura / gasto / recepción / tarea) con los campos extraídos, importes como MoneyString.
  proposedActionJson   Json                   @default("{}") @map("proposed_action_json")
  /// Comprobaciones (cuadre, NIF, duplicado, proveedor conocido…) con resultado pass | warn | fail.
  checksJson           Json                   @default("[]") @map("checks_json")
  /// Campos corregidos por el revisor (`review`); prevalecen sobre la extracción.
  reviewedFieldsJson   Json?                  @map("reviewed_fields_json")
  /// Campos + texto de páginas para la búsqueda del archivo (sin datos de tarjeta); null tras la purga.
  searchText           String?                @map("search_text")
  /// Remitente, asunto, message-id… cuando source = email.
  emailMetaJson        Json?                  @map("email_meta_json")
  capturedBy           String?                @map("captured_by")
  capturedAt           DateTime               @default(now()) @map("captured_at")
  sentAt               DateTime?              @map("sent_at")
  assignedTo           String?                @map("assigned_to")
  reviewStartedAt      DateTime?              @map("review_started_at")
  decidedBy            String?                @map("decided_by")
  decidedAt            DateTime?              @map("decided_at")
  /// illegible · missing_pages · duplicate · not_ours · other.
  rejectReason         String?                @map("reject_reason")
  rejectNote           String?                @map("reject_note")
  supplierBillId       String?                @map("supplier_bill_id")
  expenseId            String?                @map("expense_id")
  goodsReceiptId       String?                @map("goods_receipt_id")
  /// AiHumanReviewItem.id (relatedEntityType incoming_document).
  reviewItemId         String?                @map("review_item_id")
  dispatchBatchId      String?                @map("dispatch_batch_id")
  /// Documento que absorbió a este en un `merge` (el absorbido queda archived sin fichero propio).
  mergedIntoId         String?                @map("merged_into_id")
  postedAt             DateTime?              @map("posted_at")
  archivedAt           DateTime?              @map("archived_at")
  /// Fin de la retención legal (§7.5): al vencer, blockedAt; 12 meses después, deletedAt + purga del fichero, salvo legalHold.
  retentionUntil       DateTime?              @map("retention_until") @db.Date
  extendedRetention    Boolean                @default(false) @map("extended_retention")
  legalHold            Boolean                @default(false) @map("legal_hold")
  blockedAt            DateTime?              @map("blocked_at")
  deletedAt            DateTime?              @map("deleted_at")
  /// Huésped al que se refiere el documento (pseudonimización en executeErasure).
  guestId              String?                @map("guest_id")
  /// Páginas FÍSICAS del fichero original que forman este documento, en orden lógico (`[3, 4]`); null = todas. Lo fija `split` (trozos y origen) y lo lee el pipeline para recortar texto y filas de página.
  sourcePagesJson      Json?                  @map("source_pages_json")
  /// Nota de captura (subida, recaptura o remitente/asunto del correo): el pipeline la conserva en searchText en cada extracción.
  captureNote          String?                @map("capture_note")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at")

  files                DocumentFile[]
  pages                DocumentPage[]
  extractions          DocumentExtraction[]
  actions              DocumentAction[]

  @@unique([propertyId, registryNumber])
  @@unique([propertyId, registryYear, registrySeq])
  @@index([organizationId, status, sentAt])
  @@index([propertyId, status, capturedAt])
  @@index([organizationId, sha256])
  @@index([organizationId, supplierId, documentNumber])
  @@index([organizationId, retentionUntil])
  @@map("incoming_documents")
}

/// Fichero de un documento entrante: original, imagen de página, etiqueta, hoja de remesa o derivado (recaptura).
/// `inline` solo cuando storageKind = inline (ficheros pequeños en desarrollo/tests); disk / s3 usan storageKey (clave `org/<orgId>/documents/<docId>/…`).
model DocumentFile {
  id          String              @id @default(cuid())
  documentId  String              @map("document_id")
  /// original · page_image · label · dispatch_sheet · derived.
  role        String              @default("original")
  pageNo      Int?                @map("page_no")
  fileName    String              @map("file_name")
  mimeType    String              @map("mime_type")
  sizeBytes   Int                 @map("size_bytes")
  sha256      String
  storageKind DocumentStorageKind @default(disk) @map("storage_kind")
  storageKey  String?             @map("storage_key")
  /// Contenido en base64 cuando storageKind = inline; null en el resto.
  inline      String?
  encrypted   Boolean             @default(false)
  uploadedBy  String?             @map("uploaded_by")
  createdAt   DateTime            @default(now()) @map("created_at")

  document    IncomingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([storageKey])
  @@index([documentId, role, pageNo])
  @@map("document_files")
}

/// Página de un documento entrante (texto extraído y clasificación por página; base de split / merge).
model DocumentPage {
  id             String  @id @default(cuid())
  documentId     String  @map("document_id")
  pageNo         Int     @map("page_no")
  /// Tipo detectado en la página (mismo catálogo que IncomingDocumentKind) cuando difiere del documento.
  kind           String?
  /// true si la página continúa la anterior (mismo documento lógico).
  isContinuation Boolean @default(false) @map("is_continuation")
  textExtracted  String? @map("text_extracted")
  /// DocumentFile.id de la imagen de la página (role page_image).
  imageFileId    String? @map("image_file_id")
  width          Int?
  height         Int?

  document       IncomingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNo])
  @@map("document_pages")
}

/// Una ejecución de clasificación/extracción sobre el documento (IA vía ai-core, reglas de texto, e-factura o manual): campos, confianza y coste.
model DocumentExtraction {
  id             String   @id @default(cuid())
  documentId     String   @map("document_id")
  runNo          Int      @map("run_no")
  /// ai · text_rules · e_invoice · manual.
  source         String
  provider       String?
  modelVersion   String?  @map("model_version")
  schemaVersion  Int      @default(1) @map("schema_version")
  /// Campos extraídos (NIF, fecha, número, bases por tipo, cuotas, total, líneas…) con importes como MoneyString.
  fieldsJson     Json     @default("{}") @map("fields_json")
  /// Confianza 0–1 por campo.
  confidenceJson Json     @default("{}") @map("confidence_json")
  warningsJson   Json     @default("[]") @map("warnings_json")
  tokensInput    Int?     @map("tokens_input")
  tokensOutput   Int?     @map("tokens_output")
  costEur        Decimal? @map("cost_eur") @db.Decimal(10, 4)
  durationMs     Int?     @map("duration_ms")
  /// done · failed · skipped.
  status         String   @default("done")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  document       IncomingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, runNo])
  @@map("document_extractions")
}

/// Tarea con plazo derivada de un documento (carta, notificación, contrato): respond · pay · file · forward · verify (§7.3).
model DocumentAction {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  propertyId     String               @map("property_id")
  documentId     String               @map("document_id")
  /// respond · pay · file · forward · verify.
  kind           String
  title          String
  description    String?
  assignedTo     String?              @map("assigned_to")
  dueAt          DateTime?            @map("due_at")
  status         DocumentActionStatus @default(open)
  outcomeNote    String?              @map("outcome_note")
  completedBy    String?              @map("completed_by")
  completedAt    DateTime?            @map("completed_at")
  createdBy      String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")

  document       IncomingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([propertyId, status])
  @@map("document_actions")
}

/// Valija: lote de documentos en papel que sale del centro hacia la oficina con hoja de remesa (§6.4).
model DocumentDispatchBatch {
  id            String    @id @default(cuid())
  propertyId    String    @map("property_id")
  /// Secuencia por centro (1, 2, 3…).
  batchNumber   Int       @map("batch_number")
  closedBy      String    @map("closed_by")
  closedAt      DateTime  @default(now()) @map("closed_at")
  receivedBy    String?   @map("received_by")
  receivedAt    DateTime? @map("received_at")
  documentCount Int       @default(0) @map("document_count")
  /// DocumentFile.id de la hoja de remesa (PDF, role dispatch_sheet).
  sheetFileId   String?   @map("sheet_file_id")

  @@unique([propertyId, batchNumber])
  @@map("document_dispatch_batches")
}

/// Recepción de mercancía (albarán) por centro; base del cotejo a 2 vías con las líneas de factura (§7.2).
model GoodsReceipt {
  id                 String             @id @default(cuid())
  organizationId     String             @map("organization_id")
  propertyId         String             @map("property_id")
  supplierId         String?            @map("supplier_id")
  supplierTaxId      String?            @map("supplier_tax_id")
  deliveryNoteNumber String             @map("delivery_note_number")
  deliveryDate       DateTime           @map("delivery_date") @db.Date
  /// Pedido de compra (hoy en memoria; escritor Prisma pendiente → cotejo a 3 vías).
  purchaseOrderId    String?            @map("purchase_order_id")
  status             GoodsReceiptStatus @default(received)
  receivedBy         String?            @map("received_by")
  incomingDocumentId String?            @map("incoming_document_id")
  note               String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  lines              GoodsReceiptLine[]

  @@unique([organizationId, supplierId, deliveryNoteNumber])
  @@index([propertyId, deliveryDate])
  @@map("goods_receipts")
}

/// Línea de albarán; stockMovementId cuando la recepción generó movimiento de inventario en la misma transacción.
/// Cantidades en Decimal(12,3) como SupplierBillLine.quantity (cotejo sin redondeos cruzados).
model GoodsReceiptLine {
  id                  String   @id @default(cuid())
  goodsReceiptId      String   @map("goods_receipt_id")
  lineNo              Int      @default(1) @map("line_no")
  description         String
  inventoryItemId     String?  @map("inventory_item_id")
  purchaseOrderLineId String?  @map("purchase_order_line_id")
  quantityOrdered     Decimal? @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived    Decimal  @map("quantity_received") @db.Decimal(12, 3)
  unit                String?
  unitPrice           Decimal? @map("unit_price") @db.Decimal(12, 4)
  base                Decimal? @db.Decimal(12, 2)
  taxRate             Decimal? @map("tax_rate") @db.Decimal(5, 2)
  stockMovementId     String?  @map("stock_movement_id")

  goodsReceipt        GoodsReceipt    @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  matches             BillLineMatch[]

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

/// Cotejo línea de factura ↔ línea de albarán (2 vías; purchaseOrderLineId reservado para 3 vías). Varianzas = factura − albarán.
model BillLineMatch {
  id                  String   @id @default(cuid())
  supplierBillLineId  String   @map("supplier_bill_line_id")
  goodsReceiptLineId  String   @map("goods_receipt_line_id")
  purchaseOrderLineId String?  @map("purchase_order_line_id")
  matchedQuantity     Decimal? @map("matched_quantity") @db.Decimal(12, 3)
  matchedBase         Decimal? @map("matched_base") @db.Decimal(12, 2)
  quantityVariance    Decimal? @map("quantity_variance") @db.Decimal(12, 3)
  /// Diferencia de precio unitario (EUR, sin IVA).
  priceVariance       Decimal? @map("price_variance") @db.Decimal(12, 4)
  /// auto · confirmed · rejected.
  status              String   @default("auto")
  matchedBy           String?  @map("matched_by")
  createdAt           DateTime @default(now()) @map("created_at")

  supplierBillLine    SupplierBillLine @relation(fields: [supplierBillLineId], references: [id], onDelete: Cascade)
  goodsReceiptLine    GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)

  @@unique([supplierBillLineId, goodsReceiptLineId])
  @@index([goodsReceiptLineId])
  @@map("bill_line_matches")
}

/// Ajustes del módulo de documentos por organización (una fila por organización; valores por defecto de la tanda T9).
model DocumentSettings {
  id                      String   @id @default(cuid())
  organizationId          String   @unique @map("organization_id")
  /// SLA de la oficina en días laborables desde sentAt hasta approved / rejected (§6.3).
  officeSlaBusinessDays   Int      @default(2) @map("office_sla_business_days")
  autoSendToOffice        Boolean  @default(false) @map("auto_send_to_office")
  /// Tipos (IncomingDocumentKind) que pueden enviarse a la IA; [] = todos los que permita ai-core.
  aiAllowedKindsJson      Json     @default("[]") @map("ai_allowed_kinds_json")
  /// Tolerancias del cotejo (§7.2): precio en %, cantidad en unidades, importe en EUR.
  priceTolerancePct       Decimal  @default(2) @map("price_tolerance_pct") @db.Decimal(5, 2)
  quantityTolerance       Decimal  @default(0) @map("quantity_tolerance") @db.Decimal(12, 3)
  amountToleranceAbs      Decimal  @default(1.00) @map("amount_tolerance_abs") @db.Decimal(12, 2)
  /// true → approveSupplierBill exige cotejo sin variance (409 SUPPLIER_BILL_MATCH_REQUIRED).
  requireMatchForApproval Boolean  @default(false) @map("require_match_for_approval")
  /// Retención legal en años: facturas / albaranes / tickets (6, art. 30 CCom), correspondencia de proveedores (6, art. 30 CCom; 4 solo para documentos con datos personales sin efecto fiscal, regla fija de retention-rules.ts) y ampliada (10).
  retentionYearsDefault   Int      @default(6) @map("retention_years_default")
  letterRetentionYears    Int      @default(6) @map("letter_retention_years")
  extendedRetentionYears  Int      @default(10) @map("extended_retention_years")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("document_settings")
}

/// Gasto menor / ticket pagado en el acto: D 6xx (base [+ cuota si no deducible]) / D 472.tipo / H 570|5721|572.
model Expense {
  id                     String          @id @default(cuid())
  organizationId         String          @map("organization_id")
  propertyId             String?         @map("property_id")
  date                   DateTime        @db.Date
  supplierName           String          @map("supplier_name")
  supplierNif            String?         @map("supplier_nif")
  concept                String
  accountCode            String          @map("account_code")
  base                   Decimal         @db.Decimal(12, 2)
  taxRate                Decimal         @map("tax_rate") @db.Decimal(5, 2)
  quota                  Decimal         @db.Decimal(12, 2)
  total                  Decimal         @db.Decimal(12, 2)
  paidWith               ExpensePaidWith @map("paid_with")
  /// IVA deducible solo con factura completa (o simplificada con NIF del destinatario); ticket sin NIF → false y la cuota va a gasto.
  vatDeductible          Boolean         @default(true) @map("vat_deductible")
  receiptObjectKey       String?         @map("receipt_object_key")
  journalEntryId         String?         @map("journal_entry_id")
  reversalJournalEntryId String?         @map("reversal_journal_entry_id")
  cancelledAt            DateTime?       @map("cancelled_at")
  createdBy              String?         @map("created_by")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([organizationId, date])
  @@index([propertyId, date])
  @@map("expenses")
}

/// Amortización mensual por organización: una corrida por mes, un asiento D 68x / H 28x con una línea por elemento.
model DepreciationRun {
  id                     String                @id @default(cuid())
  organizationId         String                @map("organization_id")
  propertyId             String?               @map("property_id")
  /// "YYYY-MM".
  period                 String
  periodStart            DateTime              @map("period_start") @db.Date
  periodEnd              DateTime              @map("period_end") @db.Date
  status                 DepreciationRunStatus @default(draft)
  totalAmount            Decimal               @default(0) @map("total_amount") @db.Decimal(12, 2)
  journalEntryId         String?               @map("journal_entry_id")
  reversalJournalEntryId String?               @map("reversal_journal_entry_id")
  createdBy              String?               @map("created_by")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  lines                  DepreciationLine[]

  @@unique([organizationId, period])
  @@index([organizationId, status])
  @@map("depreciation_runs")
}

model DepreciationLine {
  id                String   @id @default(cuid())
  runId             String   @map("run_id")
  fixedAssetId      String   @map("fixed_asset_id")
  amount            Decimal  @db.Decimal(12, 2)
  accumulatedAfter  Decimal  @map("accumulated_after") @db.Decimal(12, 2)
  netBookValueAfter Decimal  @map("net_book_value_after") @db.Decimal(12, 2)

  run               DepreciationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, fixedAssetId])
  @@index([fixedAssetId])
  @@map("depreciation_lines")
}

/// Arqueo / cierre de caja por propiedad, caja (outletId "*" = recepción) y fecha de negocio.
model CashClosure {
  id                   String            @id @default(cuid())
  propertyId           String            @map("property_id")
  /// "*" = caja de recepción (toda la propiedad); Outlet.id = caja de ese punto de venta.
  outletId             String            @default("*") @map("outlet_id")
  businessDate         DateTime          @map("business_date") @db.Date
  status               CashClosureStatus @default(open)
  openedAt             DateTime          @default(now()) @map("opened_at")
  closedAt             DateTime?         @map("closed_at")
  /// Fondo de caja inicial.
  openingFloat         Decimal           @default(0) @map("opening_float") @db.Decimal(12, 2)
  /// Efectivo esperado = fondo + cobros en efectivo (Payment cash + TPV cash) − devoluciones en efectivo − pagos de caja (Expense cash).
  expectedCash         Decimal           @default(0) @map("expected_cash") @db.Decimal(12, 2)
  countedCash          Decimal?          @map("counted_cash") @db.Decimal(12, 2)
  /// countedCash − expectedCash (positivo = sobrante).
  difference           Decimal?          @db.Decimal(12, 2)
  /// { cash: {expected, counted, difference}, card_terminal: {...}, bank_transfer: {...}, ... } (importes en string decimal).
  expectedByMethodJson Json              @default("{}") @map("expected_by_method_json")
  countedByMethodJson  Json              @default("{}") @map("counted_by_method_json")
  /// Recuento físico: [{ denomination: "50", quantity: 3, amount: "150.00" }, ...] y lotes de datáfono.
  countsJson           Json              @default("[]") @map("counts_json")
  notes                String?
  openedBy             String?           @map("opened_by")
  closedBy             String?           @map("closed_by")
  approvedBy           String?           @map("approved_by")
  approvedAt           DateTime?         @map("approved_at")
  /// Asiento de la diferencia de arqueo (D 659 / H 570 faltante · D 570 / H 759 sobrante) y, si procede, del traspaso a banco.
  journalEntryId       String?           @map("journal_entry_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@unique([propertyId, outletId, businessDate])
  @@index([propertyId, status])
