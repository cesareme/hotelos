// MenuItem — what the POS sells. Linked to a PosOutlet (string id) so the
// same property can have different menus per outlet (restaurant/bar/spa).
// A MenuItem optionally has a MenuRecipe that decrements InventoryItems
// when the ticket closes — bridging POS revenue with F&B inventory.
model MenuItem {
  id          String   @id @default(cuid())
  propertyId  String   @map("property_id")
  outletId    String   @map("outlet_id") // free string matching PosOutlet.id (e.g. "out_bar")
  sku         String?
  name        String
  category    String?
  price       Decimal  @db.Decimal(12, 2)
  taxRate     Decimal? @map("tax_rate") @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([propertyId, outletId, name])
  @@index([propertyId, outletId, active])
  @@map("menu_items")
}

// MenuRecipe — a line in the bill-of-materials of a MenuItem. One sale of
// the MenuItem consumes `quantity` of `inventoryItemId` (in the item's unit).
// Examples:
//   "Copa vino tinto"  → 0.15 botella Rioja Reserva
//   "Café con leche"   → 0.008 kg café molido + 0.18 L leche
//   "Ración patatas"   → 0.35 kg patatas + 0.05 L aceite
model MenuRecipe {
  id              String   @id @default(cuid())
  menuItemId      String   @map("menu_item_id")
  inventoryItemId String   @map("inventory_item_id")
  quantity        Decimal  @db.Decimal(12, 4)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([menuItemId])
  @@index([inventoryItemId])
  @@map("menu_recipes")
}

model StockMovement {
