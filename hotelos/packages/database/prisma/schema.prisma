  status          String    @default("OPEN")
  priority        String    @default("MEDIUM")
  dueDate         DateTime? @map("due_date")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([propertyId])
  @@map("compliance_tasks")
}

// =============================================================================
// Tourist tax engine (multi-CCAA, calendar-aware)
// =============================================================================
//
// España es uno de los pocos países donde la tasa turística se decide a nivel
// autonómico Y municipal, con tablas que cambian cada año (a veces a mitad de
// año por aprobación parlamentaria), tarifa por categoría de establecimiento,
// número máximo de noches gravables y exenciones por edad.
//
// El motor cumple 3 funciones:
//   1. Catálogo (`TouristTaxRate`): qué se cobra en cada jurisdicción, válido
//      en un rango de fechas. Soporta tarifas escalonadas por categoría de
//      hotel (eg. Cataluña: 5* lujo > 5* > 4* > 3* > camping...).
//   2. Aplicación (`TouristTaxApplication`): qué se ha aplicado a cada estancia,
//      con quién pagaba y si se cargó al folio. Permite informe trimestral
//      autoliquidable.
//   3. Exenciones (`TouristTaxExemption`): menores, viajes médicos, fuerzas
//      armadas, etc. — distintas por CCAA.

model TouristTaxRate {
  id                 String   @id @default(cuid())
  // Jurisdicción: combinación de país (ES) + comunidad autónoma + municipio
  // (opcional, para tasas municipales como Barcelona o San Sebastián).
  country            String   @default("ES")
  ccaaCode           String   @map("ccaa_code") // p.ej. CAT, BAL, CAN, EUSK
  municipality       String?  // null = aplica a toda la CCAA
  // Categoría del establecimiento — cada CCAA tiene su propio escalado:
  // CAT: lujo_5e, 5_estrellas, 4_estrellas, 3_estrellas, 2_o_menos, camping...
  // BAL: 5_estrellas, 4_estrellas, 3_estrellas, apt_4_4sup, apt_3_2_1...
  // Almacenado como string para flexibilidad. La UI lo presenta como dropdown.
  establishmentClass String   @map("establishment_class")
  // Tarifa en EUR por persona y noche.
  amountPerPersonNight Decimal @db.Decimal(6, 4) @map("amount_per_person_night")
  currency           String   @default("EUR")
  // Validez: la mayoría de tarifas tienen `validUntil = null` (sigue vigente
  // hasta que la sustituya otra).
  validFrom          DateTime @map("valid_from") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date
  // Máximo de noches por estancia (CAT cobra hasta 7; otras 0 = sin límite).
  maxNightsPerStay   Int      @default(0) @map("max_nights_per_stay")
  // Recarga por temporada alta (p.ej. CAT verano +2 €): expresada como
  // % adicional sobre la tarifa base, aplicado solo entre highSeasonFrom y
  // highSeasonUntil (mm-dd, año actual).
  highSeasonSurcharge Decimal? @db.Decimal(5, 4) @map("high_season_surcharge")
  highSeasonFromMmdd  String?  @map("high_season_from_mmdd")  // "06-15"
  highSeasonUntilMmdd String?  @map("high_season_until_mmdd") // "09-15"
  // Edad mínima gravable. La mayoría 16 años; alguna 0.
  taxableAgeFrom     Int      @default(16) @map("taxable_age_from")
  // Legal source (BOE/DOGC/BOJA reference) for auditability.
  legalSource        String?  @map("legal_source")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([country, ccaaCode, municipality])
  @@index([validFrom, validUntil])
  @@map("tourist_tax_rates")
}

model TouristTaxApplication {
  id                String   @id @default(cuid())
  propertyId        String   @map("property_id")
  reservationId     String   @map("reservation_id")
  folioId           String?  @map("folio_id")
  folioLineId       String?  @map("folio_line_id")
  rateId            String   @map("rate_id")
  // Snapshot of the rate at the moment of application (for reproducibility
  // even if rates table is edited later).
  ccaaCode          String   @map("ccaa_code")
  municipality      String?
  establishmentClass String  @map("establishment_class")
  amountPerPersonNight Decimal @db.Decimal(6, 4) @map("amount_per_person_night")
  currency          String   @default("EUR")
  // Computation details — replicable from these fields alone.
  adultsTaxable     Int      @map("adults_taxable")
  nightsTaxable     Int      @map("nights_taxable")
  totalAmount       Decimal  @db.Decimal(10, 2) @map("total_amount")
  stayFrom          DateTime @map("stay_from") @db.Date
  stayUntil         DateTime @map("stay_until") @db.Date
  exemptionsApplied Json?    @map("exemptions_applied") // [{ guestId, reason }]
  appliedAt         DateTime @default(now()) @map("applied_at")

  @@index([propertyId, stayFrom])
  @@index([reservationId])
  @@map("tourist_tax_applications")
}

model TouristTaxExemption {
  id             String   @id @default(cuid())
  ccaaCode       String   @map("ccaa_code")
  code           String   // "MENORES_16", "MEDICAL_TRIP", "ARMED_FORCES", ...
  description    String
  // Optional age range when applicable.
  ageFrom        Int?     @map("age_from")
  ageTo          Int?     @map("age_to")
  active         Boolean  @default(true)
  legalSource    String?  @map("legal_source")

  @@index([ccaaCode, active])
  @@map("tourist_tax_exemptions")
}

// =============================================================================
// CSRD / ESRS reporting (mandatorio en 2026 para grandes empresas)
// =============================================================================
//
// La Corporate Sustainability Reporting Directive (CSRD) obliga a publicar
// indicadores ESRS (European Sustainability Reporting Standards) en 4 áreas:
//   E (Environment): Scope 1/2/3 CO2, agua, energía, residuos.
//   S (Social): plantilla, accidentes, brecha salarial, diversidad.
//   G (Governance): conflictos de interés, anti-corrupción.
//   General: cadena de valor, materialidad.
//
// Grandes empresas (>250 empleados, >50M€ facturación, >25M€ balance) deben
// reportar con datos 2025 antes de fin de 2026. Las cadenas hoteleras
// españolas medianas (Meliá, NH, RIU…) entran en este perímetro.
//
// Este módulo solo modela los datos primarios; el cálculo de indicadores y la
// exportación al formato XBRL/iXBRL queda en el servicio.

model EsrsIndicator {
  id              String   @id @default(cuid())
  propertyId      String?  @map("property_id")
  organizationId  String   @map("organization_id")
  /** Ejercicio: "2025", "2026". */
  fiscalYear      String   @map("fiscal_year")
  /** Standard ESRS: "ESRS_E1", "ESRS_E2", "ESRS_S1", etc. */
  standardCode    String   @map("standard_code")
  /** Disclosure: "E1-6_GHG_Scope1", "E1-6_GHG_Scope2_LocationBased", "S1-6_Headcount". */
  disclosureCode  String   @map("disclosure_code")
  /** Tipo: NUMERIC | TEXT | BOOLEAN | PERCENTAGE | MONETARY. */
  valueType       String   @map("value_type")
  numericValue    Decimal? @db.Decimal(16, 4) @map("numeric_value")
  textValue       String?  @map("text_value")
  unit            String?  // tCO2e, m3, kWh, EUR, headcount...
  /** Fuente del dato: "manual", "imported_sap", "energy_meter_iot", etc. */
  source          String   @default("manual")
  /** Cualquier metadato adicional (notas, fórmulas, períodos). */
  metadataJson    Json?    @map("metadata_json")
  computedAt      DateTime @default(now()) @map("computed_at")
  reportedAt      DateTime? @map("reported_at")

  @@unique([organizationId, propertyId, fiscalYear, disclosureCode])
  @@index([organizationId, fiscalYear, standardCode])
  @@map("esrs_indicators")
}

model EsrsReport {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  fiscalYear      String   @map("fiscal_year")
  status          String   @default("draft") // draft, ready, submitted
  /** Formato exportable: "xbrl_inline", "pdf", "json". */
  format          String   @default("json")
  /** Hash de los datos para integridad — cambia si se altera el contenido. */
  contentHash     String?  @map("content_hash")
  /** Resumen ejecutivo generado: { totalIndicators, completeness%, ... }. */
  summaryJson     Json?    @map("summary_json")
  payloadXbrl     String?  @map("payload_xbrl") @db.Text
  generatedBy     String?  @map("generated_by")
  generatedAt     DateTime @default(now()) @map("generated_at")
  submittedAt     DateTime? @map("submitted_at")

  @@unique([organizationId, fiscalYear])
  @@index([organizationId, status])
  @@map("esrs_reports")
}

// =============================================================================
// OAuth2 / Marketplace público — emisión de tokens para apps de terceros
// =============================================================================
//
// Apaleo y Mews siguen este patrón: la cadena hotelera autoriza una "App"
// (RoomDiary, un CRM, un BI...) que recibe scopes específicos y puede consumir
// la API del PMS en nombre del hotel.
//
// Flujo soportado:
//   1. Authorization Code + PKCE — la App redirige al hotel a /oauth/authorize.
//   2. Client Credentials — para integraciones server-to-server (typical para
//      partners empresariales).
//
// Tokens almacenados con hash; refresh tokens rotativos.

model OAuthAuthorizationCode {
  id              String   @id @default(cuid())
  appId           String   @map("app_id")
  organizationId  String   @map("organization_id")
  propertyId      String?  @map("property_id")
  userId          String?  @map("user_id")
  codeHash        String   @unique @map("code_hash")
  codeChallenge   String?  @map("code_challenge")
  codeChallengeMethod String? @map("code_challenge_method")
  redirectUri     String   @map("redirect_uri")
  scopes          String[]
  expiresAt       DateTime @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([appId, expiresAt])
  @@map("oauth_authorization_codes")
}

model OAuthToken {
  id              String   @id @default(cuid())
  appId           String   @map("app_id")
  organizationId  String   @map("organization_id")
  propertyId      String?  @map("property_id")
  userId          String?  @map("user_id")
  /** "access" | "refresh". */
  kind            String
  tokenHash       String   @unique @map("token_hash")
  scopes          String[]
  expiresAt       DateTime @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  /** Cuando un refresh token genera uno nuevo, lo encadenamos. */
  rotatedFromId   String?  @map("rotated_from_id")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([appId, kind, expiresAt])
  @@index([tokenHash])
  @@map("oauth_tokens")
}

model MarketplaceListing {
  id              String   @id @default(cuid())
  appId           String   @unique @map("app_id")
  publishedAt     DateTime? @map("published_at")
  status          String   @default("draft") // draft | review | published | unlisted
  category        String   // crm, channel_manager, payments, accounting, smart_lock, energy, etc.
  /** Snippet visible en el catálogo. */
  tagline         String
  description     String   @db.Text
  iconUrl         String?  @map("icon_url")
  screenshotsJson Json?    @map("screenshots_json")
  pricing         String?  // "free" | "freemium" | "paid" | "contact_sales"
  privacyUrl      String?  @map("privacy_url")
  termsUrl        String?  @map("terms_url")
  /** Apps verificadas tienen badge. */
  verified        Boolean  @default(false)
  installsCount   Int      @default(0) @map("installs_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status, category])
  @@map("marketplace_listings")
}

model AppInstallation {
  id              String   @id @default(cuid())
  appId           String   @map("app_id")
  organizationId  String   @map("organization_id")
  propertyId      String?  @map("property_id")
  scopes          String[]
  installedAt     DateTime @default(now()) @map("installed_at")
  uninstalledAt   DateTime? @map("uninstalled_at")
  installedByUserId String? @map("installed_by_user_id")

  @@unique([appId, organizationId, propertyId])
  @@index([organizationId, propertyId])
  @@map("app_installations")
}

model RateChangeJournal {
  id            String   @id @default(cuid())
  propertyId    String
  userId        String
  userEmail     String?
  timestamp     DateTime @default(now())
  changesCount  Int
  changesJson   Json     // detalle de celdas afectadas
  reason        String?
  pushedTo      String[] @default([])  // channel ids
  pushStatus    String   @default("draft") // draft|pushed|failed|partial
  /// Rate grid v2 · draft | published | reverted
  status        String   @default("draft")
  /// Rate grid v2 · on the ORIGINAL entry: id of the inverse entry that reverted it
  /// (the inverse entry links back through changesJson.revertsJournalId — no column).
  revertedByJournalId String? @map("reverted_by_journal_id")
  /// Rate grid v2 · idempotency key of the editor's retries (uuid). Unique per
  /// property (cierre 2026-09-15): the engine's advisory lock already serialises
  /// retries; the constraint is the guarantee when the lock is not held (P2002 →
  /// the engine re-reads the entry the other attempt wrote).
  clientRequestId String? @map("client_request_id")
  property      Property @relation(fields: [propertyId], references: [id])
  items         RateChangeJournalItem[]
  @@unique([propertyId, clientRequestId])
  @@index([propertyId, timestamp])
  @@map("rate_change_journals")
}

/// Rate grid v2 · before/after per cell and field of a journal entry (revert source).
model RateChangeJournalItem {
  id         String   @id @default(cuid())
  journalId  String   @map("journal_id")
  ratePlanId String   @map("rate_plan_id")
  roomTypeId String   @map("room_type_id")
  date       DateTime @db.Date
  channelId  String?  @map("channel_id")
  /// price | occupancyPrices | minPrice | maxPrice | available | <restriction key>
  field      String
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  journal    RateChangeJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([ratePlanId, roomTypeId, date])
  @@map("rate_change_journal_items")
}

// =============================================================================
// OPERA Cloud · modo sombra (Tanda 7b · L0)
// =============================================================================
// Diseño: docs/design/OPERA-CLOUD-MODO-SOMBRA.md §5 (semántica de sincronización y
// reconciliación) y §6.1 (modelo). OPERA Cloud sigue siendo el sistema de registro;
// Anfitorio recibe cada día un corte de reservas, los ingresos por transaction code
// y, con menos frecuencia, perfiles y estadísticas; nunca escribe en OPERA. Todo es
// ADITIVO: ninguna columna nueva en `reservations` (la relación 1:1 con
// `pms_shadow_links` vive en la tabla de enlace) y ningún enum nuevo (los estados
// son texto con su catálogo en packages/shared/src/pms-shadow-types.ts).
// GDPR: ninguna de estas tablas guarda nombre, e-mail, teléfono ni documento del
// huésped; los ficheros recibidos no se persisten (se procesan y se descartan, como
// en la importación masiva de la Tanda 7); los mensajes y los JSON citan nº de
// confirmación, códigos, métricas e importes, nunca datos personales. Sin FK a
// properties / organizations (misma convención que ReservationImport);
// organizationId y propertyId desnormalizados para aislar cada consulta sin join.

/// Perfil «modo sombra» de una propiedad: qué PMS de registro la alimenta (hoy solo OPERA Cloud), con qué código de hotel y con qué mapeos. Uno por (propiedad, sistema).
model PmsShadowProfile {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  propertyId     String   @map("property_id")
  /// Sistema de registro (PMS_SHADOW_SYSTEMS): hoy solo `opera_cloud`.
  system         String   @default("opera_cloud")
  /// Hotel Code de OPERA (Property Controls; `hotel_code` del XML de Revenue): identifica el hotel en cada fichero recibido y da `bookingSource opera:<código>`.
  operaHotelCode String   @map("opera_hotel_code")
  /// active · paused (PMS_SHADOW_PROFILE_STATUSES). En pausa el ingest responde 409 PMS_SHADOW_PROFILE_PAUSED y el job no reclama feeds ni emite OPERA_FEED_LATE.
  status         String   @default("active")
  /// PmsShadowPropertyMapping: roomTypes / rateCodes / marketCodes / sourceCodes / paymentTypes (código OPERA → código Anfitorio) y pseudoRoomTypes[] (PM, HOUSE…: filas omitidas, no son inventario).
  mappingJson    Json     @default("{}") @map("mapping_json")
  /// PmsShadowTrxCodeMapping[]: transaction code OPERA → kind (revenue · tax · payment · ignore), cuenta PGC (705.1 / 477.10 / 570…) y departamento USALI. Código sin mapear → el importador de ingresos bloquea el día.
  trxMappingJson Json     @default("[]") @map("trx_mapping_json")
  /// { feeds: [{ feed, expectedTime "HH:mm" (hora local del hotel), businessDateOffset -1 | 0, required }] }: feeds esperados; sin fichero a la hora prevista + 2 h → OPERA_FEED_LATE.
  scheduleJson   Json     @default("{}") @map("schedule_json")
  /// Buzón dedicado del hotel al que el Report Scheduler de OPERA envía los informes (p. ej. opera-rias@…); lo lee el conector de correo con propósito pms_shadow.
  inboxEmail     String?  @map("inbox_email")
  /// Carpeta SFTP (ruta local en el VPS) donde OPERA deposita los exports; la recorre el CLI pms-shadow:pull.
  sftpFolder     String?  @map("sftp_folder")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([propertyId, system])
  @@index([organizationId, status])
  @@map("pms_shadow_profiles")
}

/// Enlace (propiedad, nº de confirmación OPERA) → reserva de Anfitorio: clave natural del upsert del modo `sync` y memoria de la última vista de cada reserva en los cortes. Sin datos personales.
model PmsShadowLink {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  propertyId          String    @map("property_id")
  /// Nº de confirmación de OPERA (`RESERVATION_ID` de Responsys, CONFIRMATION NO de los eventos): el mismo valor que Reservation.externalReference.
  confirmationNo      String    @map("confirmation_no")
  /// Id interno de OPERA (RESV NAME ID / `reservationId` de OHIP); solo llega por la vía C.
  operaReservationId  String?   @map("opera_reservation_id")
  /// Referencia CRS / OTA (`CRS_CONFIRMATION_NO`, `externalReferences[]` de OHIP); no sustituye a externalReference.
  crsReference        String?   @map("crs_reference")
  /// Reserva enlazada (única: una reserva procede como máximo de un nº de confirmación). Reactivación Cancelled → Reserved = reserva nueva y el enlace pasa a apuntar a ella.
  reservationId       String    @unique @map("reservation_id")
  /// sha256 hex de la fila normalizada en la última vista: mismo hash → `unchanged`; distinto → actualización + transición si procede.
  rowHash             String    @map("row_hash")
  /// Estado destino de la última sincronización (RESERVATION_SYNC_TARGET_STATUSES: confirmed · checked_in · checked_out · cancelled · no_show · skip).
  lastStatus          String    @map("last_status")
  lastSeenAt          DateTime  @map("last_seen_at")
  /// Business date del último corte que traía la reserva (ventana del diff de §5.2).
  lastBusinessDate    DateTime  @map("last_business_date") @db.Date
  /// Lote (ReservationImport) que creó el enlace y último lote que lo tocó (sin FK: mismo criterio que ReservationImportRow).
  firstImportId       String    @map("first_import_id")
  lastImportId        String?   @map("last_import_id")
  /// Cortes consecutivos, en ventana, en los que la reserva NO apareció ni venía cancelada / no-show (§5.2): 1 → alerta OPERA_MISSING_IN_SNAPSHOT; la cancelación es manual tras 2. Vuelve a 0 al reaparecer.
  missingStreak       Int       @default(0) @map("missing_streak")
  /// `lastModifiedDate` de OHIP (vía C), para la ventana de modificación del async dailySummary.
  operaLastModifiedAt DateTime? @map("opera_last_modified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([propertyId, confirmationNo])
  @@index([propertyId, lastBusinessDate])
  @@map("pms_shadow_links")
}

/// Ejecución de un corte (un fichero recibido o una llamada OHIP) en una propiedad: origen, feed, business date, hash, estado, contadores y alertas. Registro operativo del panel «Modo sombra». El fichero NO se guarda.
model PmsShadowRun {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  propertyId          String    @map("property_id")
  /// arrivals · inhouse · departures · changes · revenue · profiles · stats · ohip_delta (PMS_SHADOW_FEEDS).
  feed                String
  /// email · sftp · api_key · manual · ohip · cli (PMS_SHADOW_RUN_SOURCES).
  source              String
  /// Business date del corte. Opcional en el modelo (un fichero sin fecha reconocible se registra igual); el ingest de L3 siempre la rellena.
  businessDate        DateTime? @map("business_date") @db.Date
  fileName            String?   @map("file_name")
  /// sha256 hex del fichero recibido tal cual: con feed + businessDate forma la idempotencia (409 PMS_SHADOW_RUN_DUPLICATE).
  contentHash         String    @map("content_hash")
  /// received · processing · done · partial · failed (PMS_SHADOW_RUN_STATUSES). `received` queda reservado: el ingest procesa en línea y crea el run ya en `processing`.
  status              String    @default("received")
  /// Lote de reservas (feeds arrivals · inhouse · departures · changes) producido por el run; SET NULL si el lote desapareciera.
  reservationImportId String?   @map("reservation_import_id")
  /// Lote de ingresos (feed revenue) producido por el run.
  revenueImportId     String?   @map("revenue_import_id")
  createdCount        Int       @default(0) @map("created_count")
  updatedCount        Int       @default(0) @map("updated_count")
  unchangedCount      Int       @default(0) @map("unchanged_count")
  /// Reservas con transición de estado (cancelación, no-show, check-in, check-out) aplicada en el run.
  transitionedCount   Int       @default(0) @map("transitioned_count")
  skippedCount        Int       @default(0) @map("skipped_count")
  errorCount          Int       @default(0) @map("error_count")
  /// Resumen del run: valores declarados por OPERA (feed stats: Manager Report / Trial Balance), cabecera reconocida, totales… Sin PII.
  resultJson          Json      @default("{}") @map("result_json")
  /// PmsShadowRunAlert[]: alertas emitidas por el run (código, severidad, mensaje sin PII, nº de confirmación si aplica), [] si ninguna.
  alertsJson          Json      @default("[]") @map("alerts_json")
  /// Mensaje en español del fallo (sin valores personales) cuando status = failed | partial.
  errorMessage        String?   @map("error_message")
  correlationId       String?   @map("correlation_id")
  /// Usuario o app de desarrollador que originó el run (PMS_SHADOW_SYSTEM_USER_ID para el job y el conector de correo).
  createdBy           String?   @map("created_by")
  startedAt           DateTime? @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  reservationImport   ReservationImport?      @relation(fields: [reservationImportId], references: [id], onDelete: SetNull)
  revenueImport       PmsShadowRevenueImport? @relation(fields: [revenueImportId], references: [id], onDelete: SetNull)
  alerts              PmsShadowAlert[]

  @@unique([propertyId, feed, businessDate, contentHash])
  @@index([propertyId, businessDate, feed])
  @@index([propertyId, status, createdAt])
  @@map("pms_shadow_runs")
}

/// Lote de ingresos diarios de OPERA (un fichero de un business date: XML GEN_XMLBO_REVENUE, findeptcodes o RESPONSYS_TRX) → un asiento por (hotel, business date) con sourceType pms_shadow_revenue, reversible (patrón de la Tanda 6c). Sin unicidad por (propiedad, día): «un lote no revertido por día» la impone el servicio bajo advisory lock (un reverso + nuevo del mismo día conviven).
model PmsShadowRevenueImport {
  id                      String    @id @default(cuid())
  organizationId          String    @map("organization_id")
  propertyId              String    @map("property_id")
  businessDate            DateTime  @map("business_date") @db.Date
  /// xml_revenue · findeptcodes_xml · findeptcodes_csv · responsys_trx (PMS_SHADOW_REVENUE_SOURCES).
  source                  String
  fileName                String?   @map("file_name")
  /// sha256 hex del fichero recibido (409 PMS_SHADOW_REVENUE_DUPLICATE mientras exista un lote no revertido con el mismo hash en la propiedad).
  contentHash             String    @map("content_hash")
  /// draft (previsualizado, sin asiento) · posted (asiento contabilizado) · reversed (asiento revertido; `replacedById` si lo sustituyó otro lote) (PMS_SHADOW_REVENUE_STATUSES).
  status                  String    @default("draft")
  /// PmsShadowRevenueLine[]: transaction code, tipo, descripción OPERA, importe neto, ledgers, kind / cuenta / departamento resueltos por el mapeo del perfil.
  linesJson               Json      @default("[]") @map("lines_json")
  /// Σ líneas kind revenue (H 705.x), tax (H 477.x), payment (D 57x) y el resto (ignore: informativo, sin asiento).
  totalRevenue            Decimal   @default(0) @db.Decimal(14, 2) @map("total_revenue")
  totalTax                Decimal   @default(0) @db.Decimal(14, 2) @map("total_tax")
  totalPayments           Decimal   @default(0) @db.Decimal(14, 2) @map("total_payments")
  totalOther              Decimal   @default(0) @db.Decimal(14, 2) @map("total_other")
  /// Asiento(s) del día y sus reversos (ids de journal_entries).
  journalEntryIds         String[]  @default([]) @map("journal_entry_ids")
  reversalJournalEntryIds String[]  @default([]) @map("reversal_journal_entry_ids")
  /// Valores declarados por OPERA para el cuadre (Trial Balance «Transaction Total Today», Manager Report Room / Total Revenue) y el resultado de la comparación.
  reconciliationJson      Json      @default("{}") @map("reconciliation_json")
  /// Avisos del lote en español (códigos ignorados, redondeos…), [] si ninguno.
  warningsJson            Json      @default("[]") @map("warnings_json")
  /// Lote que sustituyó a este mediante `replace` (reverso + nuevo en la misma transacción).
  replacedById            String?   @map("replaced_by_id")
  createdBy               String?   @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  postedAt                DateTime? @map("posted_at")
  reversedAt              DateTime? @map("reversed_at")
  reversedBy              String?   @map("reversed_by")
  reversalReason          String?   @map("reversal_reason")

  runs                    PmsShadowRun[]

  @@index([propertyId, businessDate, status])
  @@index([propertyId, contentHash])
  @@map("pms_shadow_revenue_imports")
}

/// Alerta del modo sombra (§5.5): reserva ausente del snapshot, conflicto con una reserva local, check-in sin habitación, código sin mapear, desviación de la reconciliación, feed tardío, cabecera cambiada, fichero no reconocido. Se resuelve en el panel con motivo (auditado). Sin datos personales.
model PmsShadowAlert {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  propertyId     String    @map("property_id")
  /// Business date al que se refiere la alerta (null en alertas de fichero sin fecha reconocible).
  businessDate   DateTime? @map("business_date") @db.Date
  /// PMS_SHADOW_ALERT_CODES (OPERA_MISSING_IN_SNAPSHOT, OPERA_TRX_CODE_UNMAPPED, OPERA_FEED_LATE…).
  code           String
  /// info · warning · error (PMS_SHADOW_ALERT_SEVERITY por código).
  severity       String
  /// Mensaje en español SIN datos personales: cita nº de confirmación, código OPERA, métrica e importes; nunca nombre, e-mail ni documento.
  message        String
  /// Valor esperado (Anfitorio / perfil) y valor obtenido (OPERA / fichero): métrica, conteo, importe, cabecera…
  expectedJson   Json      @default("{}") @map("expected_json")
  actualJson     Json      @default("{}") @map("actual_json")
  /// Corte que la emitió (SET NULL si el run desapareciera); null en alertas del job (OPERA_FEED_LATE).
  runId          String?   @map("run_id")
  /// Nº de confirmación afectado, si la alerta es de una reserva.
  confirmationNo String?   @map("confirmation_no")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by")
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at")

  run            PmsShadowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([propertyId, resolvedAt, businessDate])
  @@index([propertyId, code, createdAt])
  @@map("pms_shadow_alerts")
}

// ============================================================================
// Importación contable desde Sage 200 (Tanda 7c)
// ============================================================================
// Diseño: docs/design/FINANZAS-IMPORTACION-SAGE200.md §4.2. Modelo ADITIVO: ninguna columna nueva en JournalEntry ni
// JournalLine; los asientos importados son asientos normales del motor (sourceType sage200_journal / sage200_balance) y los
// lotes solo guardan sus ids. Catálogos de texto en packages/shared/src/ledger-import-types.ts. Sin FK a properties,
// suppliers ni journal_entries (misma convención que payroll_cost_imports y pms_shadow_revenue_imports).

/// Lote de importación contable desde Sage 200 (un fichero de un tipo: plan · fiscal_years · journal · vat_books · third_parties · balances), identificado por el sha256 de las filas normalizadas tras el mapeo. draft (previsualizado, nada escrito) → posted (asientos contabilizados por postJournalEntry / filas de libros / cuentas / ejercicios) → reversed (asientos revertidos; `replacedById` si lo sustituyó otro lote). Patrón de la Tanda 6c.
model LedgerImport {
  id                      String             @id @default(cuid())
  organizationId          String             @map("organization_id")
  /// Sociedad (LegalEntity) resuelta por resolveLedgerScope al crear el lote; null si la organización aún no tiene sociedad.
  legalEntityId           String?            @map("legal_entity_id")
  /// Sistema de origen: sage200 (LEDGER_IMPORT_SYSTEMS; extensible a contaplus / a3). Sin DEFAULT en BD: lo escribe siempre el servicio.
  system                  String
  /// plan · fiscal_years · journal · vat_books · third_parties · balances (LEDGER_IMPORT_KINDS).
  kind                    String
  /// sage_excel · sage_ime_csv · sage_xml · canonical_csv · canonical_json (LEDGER_IMPORT_FORMATS).
  format                  String
  fileName                String?            @map("file_name")
  /// sha256 hex del JSON canónico de las filas normalizadas tras el mapeo (mismo hash para el Excel y el CSV equivalentes); 409 LEDGER_IMPORT_DUPLICATE mientras exista un lote no revertido con el mismo hash en la organización.
  contentHash             String             @map("content_hash")
  /// CodigoEmpresa de Sage.
  sourceCompanyCode       String?            @map("source_company_code")
  /// Ejercicio (FiscalYear.code = año natural "YYYY") al que pertenece el lote.
  fiscalYearCode          String?            @map("fiscal_year_code")
  /// Rango de meses cubierto, "YYYY-MM" (solapes: LEDGER_IMPORT_OVERLAP).
  periodFrom              String?            @map("period_from")
  periodTo                String?            @map("period_to")
  status                  LedgerImportStatus @default(draft)
  /// Filas leídas del fichero, asientos producidos, asientos omitidos (nativos, ya existentes) y avisos.
  rowCount                Int                @default(0) @map("row_count")
  entryCount              Int                @default(0) @map("entry_count")
  skippedCount            Int                @default(0) @map("skipped_count")
  warningCount            Int                @default(0) @map("warning_count")
  /// { accounts, analytics, options } aplicado al lote (LedgerImportMappingInput + opciones), para reproducirlo y auditarlo.
  mappingJson             Json               @default("{}") @map("mapping_json")
  /// Avisos del lote en español, [] si ninguno.
  warningsJson            Json               @default("[]") @map("warnings_json")
  /// Σ debe / Σ haber de los asientos contabilizados (cuadran por construcción).
  totalDebit              Decimal            @default(0) @db.Decimal(14, 2) @map("total_debit")
  totalCredit             Decimal            @default(0) @db.Decimal(14, 2) @map("total_credit")
  /// Asientos del lote y sus reversos (ids de journal_entries).
  journalEntryIds         String[]           @default([]) @map("journal_entry_ids")
  reversalJournalEntryIds String[]           @default([]) @map("reversal_journal_entry_ids")
  /// Lote que sustituyó a este mediante `replace` (reverso + nuevo en la misma transacción).
  replacedById            String?            @map("replaced_by_id")
  notes                   String?
  createdBy               String?            @map("created_by")
  createdAt               DateTime           @default(now()) @map("created_at")
  postedAt                DateTime?          @map("posted_at")
  reversedAt              DateTime?          @map("reversed_at")
  reversedBy              String?            @map("reversed_by")
  reversalReason          String?            @map("reversal_reason")

  entries                 LedgerImportEntry[]
  balances                LedgerImportBalance[]

  @@index([organizationId, kind, status, periodFrom, periodTo])
  @@index([organizationId, contentHash])
  @@map("ledger_imports")
}

/// Un asiento Sage dentro de un lote (una fila por (asiento Sage, centro): un asiento Sage con gasto en varios hoteles produce varias filas y varios asientos Anfitorio). Guarda la clave de idempotencia de Sage (empresa + ejercicio + periodo + asiento [+ canal] [+ centro]), el asiento Anfitorio producido y por qué se omitió si no se produjo.
model LedgerImportEntry {
  id                String   @id @default(cuid())
  importId          String   @map("import_id")
  organizationId    String   @map("organization_id")
  /// CodigoEmpresa · Ejercicio · NumeroPeriodo (en Sage el nº de asiento solo es único dentro de un periodo) · Asiento.
  sourceCompanyCode String   @map("source_company_code")
  sourceFiscalYear  String   @map("source_fiscal_year")
  sourcePeriod      String   @map("source_period")
  sourceEntryNumber String   @map("source_entry_number")
  /// CodigoCanal o IdDelegacion cuando Sage numera por canal / delegación.
  sourceChannel     String?  @map("source_channel")
  entryDate         DateTime @map("entry_date") @db.Date
  propertyId        String?  @map("property_id")
  /// Código del centro de trabajo, o "SOC" a nivel sociedad: la unicidad no puede apoyarse en un propertyId NULL (semántica NULL de PostgreSQL).
  propertyCode      String   @map("property_code")
  journalEntryId    String?  @map("journal_entry_id")
  /// draft · posted · skipped_native · skipped_existing · unmapped · unbalanced · error (LEDGER_IMPORT_ENTRY_STATUSES).
  status            String
  /// normal · opening · regularization · closing (JOURNAL_ENTRY_KINDS): apertura y cierres de Sage detectados por periodo o por cuenta 129.
  entryKind         String   @default("normal") @map("entry_kind")
  lineCount         Int      @map("line_count")
  debit             Decimal  @db.Decimal(14, 2)
  credit            Decimal  @db.Decimal(14, 2)
  /// Asiento nativo de Anfitorio con el que colisiona (skipped_native: factura / cobro propio; skipped_existing: asiento importado antes).
  sourceType        String?  @map("source_type")
  sourceId          String?  @map("source_id")
  warningsJson      Json     @default("[]") @map("warnings_json")

  import            LedgerImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, sourceCompanyCode, sourceFiscalYear, sourcePeriod, sourceEntryNumber, propertyCode])
  @@index([organizationId, sourceFiscalYear, sourceEntryNumber])
  @@index([journalEntryId])
  @@map("ledger_import_entries")
}

/// Fila del balance de sumas y saldos de Sage (nivel 0) importada por un lote `balances` o adjuntada a una reconciliación: cuenta Sage literal, cuenta PGC mapeada y sumas de apertura / periodo / saldo. Se conserva aunque el lote se revierta (histórico y drawer «Detalle Sage»).
model LedgerImportBalance {
  id             String   @id @default(cuid())
  importId       String   @map("import_id")
  organizationId String   @map("organization_id")
  fiscalYearCode String   @map("fiscal_year_code")
  /// "YYYY-MM" · "YYYY-Qn" · "YYYY" · "apertura".
  periodCode     String   @map("period_code")
  propertyId     String?  @map("property_id")
  /// Código del centro de trabajo o "SOC" si la fila es de sociedad (misma razón que LedgerImportEntry.propertyCode).
  propertyCode   String   @map("property_code")
  sourceAccount  String   @map("source_account")
  sourceName     String?  @map("source_name")
  /// Cuenta PGC destino tras el mapa de cuentas.
  accountCode    String   @map("account_code")
  openingDebit   Decimal  @default(0) @db.Decimal(14, 2) @map("opening_debit")
  openingCredit  Decimal  @default(0) @db.Decimal(14, 2) @map("opening_credit")
  periodDebit    Decimal  @default(0) @db.Decimal(14, 2) @map("period_debit")
  periodCredit   Decimal  @default(0) @db.Decimal(14, 2) @map("period_credit")
  /// Saldo al cierre del periodo (positivo deudor, negativo acreedor).
  closingBalance Decimal  @default(0) @db.Decimal(14, 2) @map("closing_balance")

  import         LedgerImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, periodCode, propertyCode, sourceAccount])
  @@index([organizationId, fiscalYearCode, periodCode])
  @@map("ledger_import_balances")
}

/// Mapa de cuentas persistente Sage → PGC Pymes hotelero por organización y sistema (§4.4: 7 reglas; la fila explícita gana). Una fila por cuenta Sage literal.
model LedgerAccountMap {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  /// sage200 (LEDGER_IMPORT_SYSTEMS). Sin DEFAULT en BD.
  system            String
  /// Código de cuenta Sage literal (5-12 caracteres).
  sourceAccount     String   @map("source_account")
  sourceName        String?  @map("source_name")
  /// map · map_by_rate · create · collapse · block (LEDGER_ACCOUNT_MAP_ACTIONS).
  action            String
  /// Cuenta PGC destino (map / create / collapse) o prefijo 472 / 477 (map_by_rate); null solo en block.
  accountCode       String?  @map("account_code")
  /// Solo create en grupos 6/7: departamento y línea USALI de la subcuenta nueva.
  usaliDepartment   String?  @map("usali_department")
  usaliLine         String?  @map("usali_line")
  /// collapse: escribe «Sage <cuenta> · <NIF> · <nombre>» en la descripción de la línea.
  carryCounterparty Boolean  @default(true) @map("carry_counterparty")
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, system, sourceAccount])
  @@map("ledger_account_maps")
}

/// Mapa analítico Sage → centro de trabajo y centro de coste USALI (§4.5): una fila por (dimensión, código Sage). `propertyId` para la dimensión de centro (delegación por defecto), `costCentreCode` (ROOMS · FNB · POM · ADMIN_GENERAL · SALES_MARKETING · OTHER_OPERATED · IT) para la de centro de coste (departamento por defecto).
model LedgerAnalyticsMap {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// sage200 (LEDGER_IMPORT_SYSTEMS). Sin DEFAULT en BD.
  system         String
  /// canal · delegacion · departamento · seccion · proyecto (LEDGER_ANALYTICS_DIMENSIONS).
  dimension      String
  sourceCode     String   @map("source_code")
  sourceName     String?  @map("source_name")
  propertyId     String?  @map("property_id")
  costCentreCode String?  @map("cost_centre_code")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, system, dimension, sourceCode])
  @@map("ledger_analytics_maps")
}

/// Tercero contable de Sage (cliente o proveedor): código, cuenta contable, NIF normalizado, país y razón social. Alimenta el colapso de terceros a 4300 / 400 / 410 (descripción de línea) y el 347; `supplierId` si se dio de alta como Supplier (upsert por NIF). Sin FK a suppliers.
model LedgerThirdParty {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  /// sage200 (LEDGER_IMPORT_SYSTEMS). Sin DEFAULT en BD.
  system         String
  /// CodigoCliente / CodigoProveedor de Sage.
  sourceCode     String   @map("source_code")
  /// customer · supplier (LEDGER_THIRD_PARTY_ROLES).
  role           String
  /// CodigoContable (subcuenta Sage del tercero).
  sourceAccount  String?  @map("source_account")
  taxId          String?  @map("tax_id")
  countryCode    String   @default("ES") @map("country_code")
  name           String
  supplierId     String?  @map("supplier_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, system, role, sourceCode])
  @@index([organizationId, taxId])
  @@map("ledger_third_parties")
}

/// Reconciliación del modo sombra contable (§5.2): balance de sumas y saldos de Sage del rango frente a aggregateAccountBalances de Anfitorio por cuenta destino, con tolerancias y clasificación de cada diferencia (amount_diff · native_only · missing_in_ledger · vat_diff). Una fila por ejecución; `importId` si la lanzó un lote `journal` con balance adjunto.
model LedgerReconciliation {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  importId         String?  @map("import_id")
  periodFrom       DateTime @map("period_from") @db.Date
  periodTo         DateTime @map("period_to") @db.Date
  /// Centro comparado; null = consolidado de sociedad.
  propertyId       String?  @map("property_id")
  /// sha256 del balance Sage recibido.
  sourceHash       String   @map("source_hash")
  /// ok · differences · error (LEDGER_RECONCILIATION_STATUSES).
  status           String
  accountsCompared Int      @map("accounts_compared")
  differenceCount  Int      @map("difference_count")
  /// LedgerReconciliationRow[] (por cuenta: sourceDebit, sourceCredit, ledgerDebit, ledgerCredit, diffDebit, diffCredit, classification, tolerance).
  rowsJson         Json     @default("[]") @map("rows_json")
  /// { nativeOnly, missingInLedger, amountDiff, vatDiff, tolerance, criterion } + asientos Sage no importados.
  summaryJson      Json     @default("{}") @map("summary_json")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([organizationId, periodFrom, periodTo, createdAt])
  @@map("ledger_reconciliations")
}
