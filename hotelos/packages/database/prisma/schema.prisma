/// Política de check-in de la propiedad: self check-in, verificación, depósito, asignación, kiosco.
model PropertyCheckInPolicy {
  id                             String   @id @default(cuid())
  propertyId                     String   @map("property_id")
  selfCheckInEnabled             Boolean  @default(false) @map("self_checkin_enabled")
  inviteDaysBefore               Int      @default(3) @map("invite_days_before")
  reminderDaysBefore             Int      @default(1) @map("reminder_days_before")
  /// IdentityVerificationMethod[] permitidos en la propiedad.
  allowedVerificationMethodsJson Json     @default("[\"visual_reception\",\"mrz_checksum\",\"otp_email\"]") @map("allowed_verification_methods_json")
  requireVisualCheckAtKiosk      Boolean  @default(true) @map("require_visual_check_at_kiosk")
  requireInspectedRoom           Boolean  @default(false) @map("require_inspected_room")
  /// none | balance | first_night | fixed
  depositPolicy                  String   @default("balance") @map("deposit_policy")
  depositAmount                  Decimal? @map("deposit_amount") @db.Decimal(12, 2)
  /// Corrector CHK (REV3-02): sin PSP, `paymentStatus at_reception` solo satisface depositPolicy para
  /// el huésped/kiosco si la propiedad admite el pago en recepción; recepción nunca queda bloqueada.
  allowPayAtReception            Boolean  @default(false) @map("allow_pay_at_reception")
  allowWalkIn                    Boolean  @default(false) @map("allow_walk_in")
  allowUpgradeSuggestion         Boolean  @default(true) @map("allow_upgrade_suggestion")
  /// suggest | suggest_and_confirm | preassign
  autoAssignLevel                String   @default("suggest_and_confirm") @map("auto_assign_level")
  assignmentWeightsJson          Json     @default("{}") @map("assignment_weights_json")
  /// CheckInChannel[] en orden de preferencia para la bienvenida.
  welcomeChannelOrderJson        Json     @default("[\"whatsapp\",\"email\",\"sms\"]") @map("welcome_channel_order_json")
  guestConsentText               String?  @map("guest_consent_text")
  aiDisclosureText               String?  @map("ai_disclosure_text")
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@unique([propertyId])
  @@map("property_checkin_policies")
}

