  /// NIF/CIF del proveedor (normalizado en mayúsculas sin espacios). `nifValidatedAt` marca cuándo pasó la validación de dígito de control.
  taxId            String?  @map("tax_id")
  contactJson      Json     @default("{}") @map("contact_json")
  paymentTermsJson Json     @default("{}") @map("payment_terms_json")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  // Finanzas (2026-09-15): datos fiscales y contables del proveedor (libro de recibidas, 347, SEPA).
  nifValidatedAt            DateTime? @map("nif_validated_at")
  address                   String?
  postalCode                String?   @map("postal_code")
