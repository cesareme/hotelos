// ---- RRHH · plantilla, convenio, estándares y plantilla máxima (Tanda RRHH · 2026-09-20) ----
// Diseño: docs/design/RRHH-PLANTILLA-NOMINA.md §4 · migración 20260920173000_rrhh_plantilla_nomina.
// Misma convención plana que el resto del bloque de personal (sin @relation; ids como texto).
// Employee es el EXPEDIENTE: PII cifrada por la extensión Prisma (PII_FIELDS.Employee en
// packages/database/src/crypto-fields.ts: taxId, socialSecurityNumber, email, phone, iban) con hash de
// búsqueda solo para taxId (LOOKUP_HASH_FIELDS.Employee). Los listados nunca devuelven PII
// (EmployeeSummaryDto en packages/shared/src/hr-types.ts). Datos ficticios en demo; nunca en Faranda.

/// Expediente de una persona empleada por una sociedad (legalEntityId). employeeNumber es único por sociedad.
model Employee {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")
  legalEntityId        String    @map("legal_entity_id")
  employeeNumber       String    @map("employee_number")
  /// Usuario de la app (acceso) cuando existe; la ficha de centro (StaffProfile) sigue exigiendo userId.
  userId               String?   @map("user_id")
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  /// NIF/NIE cifrado (AES-256-GCM); taxIdLookupHash = HMAC determinista para buscar y para la unicidad por sociedad.
  taxId                String    @map("tax_id")
  taxIdLookupHash      String?   @map("tax_id_lookup_hash")
  /// Número de afiliación a la Seguridad Social (cifrado).
  socialSecurityNumber String?   @map("social_security_number")
  email                String?
  phone                String?
  iban                 String?
  /// Registro retributivo (RD 902/2020): valores libres (female · male · other · undisclosed).
  gender               String?
  primaryPropertyId    String?   @map("primary_property_id")
  usaliDepartment      String?   @map("usali_department")
  jobTitle             String?   @map("job_title")
  /// active · inactive · leave
  status               String    @default("active")
  hiredAt              DateTime  @map("hired_at")
  terminatedAt         DateTime? @map("terminated_at")
  terminationReason    String?   @map("termination_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([legalEntityId, employeeNumber])
  @@unique([legalEntityId, taxIdLookupHash])
  @@index([organizationId, status])
  @@map("employees")
}

